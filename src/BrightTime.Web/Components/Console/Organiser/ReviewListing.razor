@page "/organiser/review/listings/{ListingId:guid}"
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Opportunities.Contracts
@using BrightTime.Modules.Opportunities.Domain
@using BrightTime.Modules.Opportunities.Editing
@using BrightTime.SharedKernel.Primitives
@using BrightTime.Web.Auth
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = ConsoleServices.ReviewPolicy)]
@inherits ConsoleComponent

@if (_listing is { } listing && _detail is { } detail)
{
    <PageTitle>@T.Format("organiser.review.title", ("title", detail.Title)) · BrightTime</PageTitle>

    <p class="eyebrow"><a href="/organiser/review">@T["site.nav.review"]</a></p>
    <h1>@T.Format("organiser.review.title", ("title", detail.Title))</h1>

    <dl class="facts review-facts">
        <dt>@T["organiser.col.organisation"]</dt>
        <dd><bdi>@_orgName</bdi> (@T[BrightTime.Modules.Directory.Vetting.OrganisationVetting.StatusPhrase(_orgStatus)])</dd>
        <dt>@T["organiser.col.status"]</dt>
        <dd>@T[ListingLifecycle.StatusPhrase(listing.Status)]@(listing.ChangedSinceReview ? T["organiser.review.changed_since"] : "")</dd>
        <dt>@T["organiser.review.last_changed"]</dt>
        <dd>@T.DateTime(listing.UpdatedAt)</dd>
        @if (listing.ReviewNote is { Length: > 0 } note)
        {
            <dt>@T["organiser.review.last_note"]</dt>
            <dd dir="auto">@note</dd>
        }
    </dl>

    @if (_problem is not null)
    {
        <p class="notice error" role="alert">@_problem</p>
    }

    @if (_orgStatus != OrganisationStatus.Approved && listing.Status == ListingStatus.PendingReview)
    {
        <p class="notice">@T["organiser.review.org_not_approved"]</p>
    }

    <section class="review-actions" aria-labelledby="decide-heading">
        <h2 id="decide-heading">@T["organiser.decision"]</h2>

        @switch (listing.Status)
        {
            case ListingStatus.PendingReview:
                <form method="post" @formname="publish" @onsubmit="PublishAsync">
                    <AntiforgeryToken />
                    <button type="submit">@T["organiser.review.publish"]</button>
                </form>
                @ReasonForm("changes", T["organiser.request_changes"], T["organiser.review.changes_reason"], ListingStatus.ChangesRequested, "changes_requested")
                @ReasonForm("reject", T["organiser.reject"], T["organiser.review.reject_reason"], ListingStatus.Rejected, "rejected")
                break;

            case ListingStatus.Published:
                @if (listing.ChangedSinceReview)
                {
                    <form method="post" @formname="reviewed" @onsubmit="MarkReviewedAsync">
                        <AntiforgeryToken />
                        <button type="submit">@T["organiser.review.changes_fine"]</button>
                    </form>
                }
                @ReasonForm("unpublish", T["editor.unpublish.submit"], T["organiser.review.unpublish_reason"], ListingStatus.Unpublished, "unpublished")
                break;

            case ListingStatus.Unpublished:
                <form method="post" @formname="republish" @onsubmit="PublishAsync">
                    <AntiforgeryToken />
                    <button type="submit">@T["organiser.review.republish"]</button>
                </form>
                break;

            default:
                <p>@T.Format("organiser.review.nothing_to_decide", ("status", T[ListingLifecycle.StatusPhrase(listing.Status)]))</p>
                break;
        }
    </section>

    <section class="review-preview" aria-labelledby="preview-heading">
        <h2 id="preview-heading">@T["organiser.review.as_families_see"]</h2>
        <div class="preview-frame">
            <ListingView Listing="detail" ShowPublicLinks="false" />
        </div>
    </section>
}

@code {
    [Parameter] public Guid ListingId { get; set; }

    private EditableListing? _listing;
    private ListingDetail? _detail;
    private string? _orgName;
    private OrganisationStatus _orgStatus;
    private string? _problem;
    private readonly Dictionary<string, string> _reasonErrors = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            Navigation.NotFound();
            return;
        }

        _listing = await Get<ListingEditor>().LoadAsync(ListingId);
        _detail = await Get<IListingDetails>().GetForReviewAsync(Tenant.TenantId, ListingId, Tenant.Locale.Code);
        if (_listing is null || _detail is null)
        {
            Navigation.NotFound();
            return;
        }

        IDirectoryQueries directory = Get<IDirectoryQueries>();
        _orgName = await directory.GetOrganisationNameAsync(_listing.OrganisationId);
        _orgStatus = await directory.GetStatusAsync(_listing.OrganisationId) ?? OrganisationStatus.Applied;
    }

    private async Task DecideAsync(ListingStatus to, string? reasonField, string done)
    {
        string? reason = reasonField is null ? null : FormValue("reason");
        Result result = await Get<ListingEditor>().TransitionAsync(
            ListingId, to, ListingLifecycle.Mover.Organiser, null, reason, Actor);

        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/organiser/review?done={done}");
            return;
        }

        if (reasonField is not null && result.Error!.Code == "listing.reason_required")
        {
            _reasonErrors[reasonField] = T.Error(result.Error);
        }
        else
        {
            _problem = T.Error(result.Error!);
        }
    }

    private Task PublishAsync() => DecideAsync(ListingStatus.Published, null, "published");

    private async Task MarkReviewedAsync()
    {
        Result result = await Get<ListingEditor>().MarkReviewedAsync(ListingId, Actor);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/organiser/review?done=reviewed");
            return;
        }

        _problem = T.Error(result.Error!);
    }

    private RenderFragment ReasonForm(string formName, string button, string label, ListingStatus to, string done) => __builder =>
    {
        string id = $"reason-{formName}";
        bool invalid = _reasonErrors.ContainsKey(formName);
        <form method="post" class="reason-form" @formname="@formName" @onsubmit="() => DecideAsync(to, formName, done)">
            <AntiforgeryToken />
            <div class="field">
                <label for="@id">@label</label>
                <textarea id="@id" name="reason" rows="3" aria-invalid="@(invalid ? "true" : null)" aria-describedby="@(invalid ? id + "-error" : null)"></textarea>
                @if (invalid)
                {
                    <p class="field-error" id="@id-error">@_reasonErrors[formName]</p>
                }
            </div>
            <button type="submit" class="secondary-button">@button</button>
        </form>
    };
}
