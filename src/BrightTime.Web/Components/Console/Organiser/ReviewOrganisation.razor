@page "/organiser/review/organisations/{OrgId:guid}"
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Directory.Review
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.SharedKernel.Ids
@using BrightTime.SharedKernel.Primitives
@using BrightTime.Web.Auth
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = ConsoleServices.VetPolicy)]
@inherits ConsoleComponent

@if (_org is { } o)
{
    <PageTitle>@T.Format("organiser.review.title", ("title", o.DisplayName)) · BrightTime</PageTitle>

    <p class="eyebrow"><a href="/organiser/review">@T["site.nav.review"]</a></p>
    <h1>@o.DisplayName</h1>

    @if (_problem is not null)
    {
        <p class="notice error" role="alert">@_problem</p>
    }

    <dl class="facts review-facts">
        <dt>@T["organiser.col.status"]</dt><dd>@T[BrightTime.Modules.Directory.Vetting.OrganisationVetting.StatusPhrase(o.Status)]</dd>
        <dt>@T["organiser.org.legal_name"]</dt><dd dir="auto">@o.LegalName</dd>
        <dt>@T["organiser.org.kind"]</dt><dd>@(T.Has("organisation.kind." + o.Kind) ? T["organisation.kind." + o.Kind] : o.Kind.Replace('_', ' '))</dd>
        @if (o.WebsiteUrl is { } site)
        {
            @* Shown as text, not a link: an applicant's URL is unvetted. *@
            <dt>@T["organiser.org.website"]</dt><dd><code dir="ltr">@site</code></dd>
        }
        @if (o.PublicEmail is { } email)
        {
            <dt>@T["account.field.email"]</dt><dd dir="ltr">@email</dd>
        }
        @if (o.PublicPhone is { } phone)
        {
            <dt>@T["editor.field.contact_phone"]</dt><dd dir="ltr">@phone</dd>
        }
        <dt>@T["listing.fact.languages"]</dt><dd>@string.Join(T["format.list_separator"], o.LanguagesServed.Select(c => T.Has("language." + c) ? T["language." + c] : c))</dd>
        <dt>@T["organiser.col.applied"]</dt><dd>@Local(o.SubmittedAt)</dd>
        <dt>@T["organiser.org.active_owners"]</dt><dd>@T.Number(o.ActiveOwners)</dd>
        <dt>@T["editor.field.sites"]</dt>
        <dd>
            @if (o.Sites.Count == 0)
            {
                <span>@T["organiser.org.no_sites"]</span>
            }
            else
            {
                <ul>@foreach (string s in o.Sites) { <li dir="auto">@s</li> }</ul>
            }
        </dd>
    </dl>

    @if (o.Mission is { Length: > 0 } mission)
    {
        <h2>@T["organiser.org.mission"]</h2>
        <p dir="auto">@mission</p>
    }

    <section class="review-actions" aria-labelledby="decide-heading">
        <h2 id="decide-heading">@T["organiser.decision"]</h2>
        @if (o.Status == OrganisationStatus.Applied)
        {
            <form method="post" @formname="start" @onsubmit="StartReviewAsync">
                <AntiforgeryToken />
                <button type="submit" class="secondary-button">@T["organiser.org.start_review"]</button>
                <span class="hint">@T["organiser.org.start_review_hint"]</span>
            </form>
        }
        @if (o.Status is OrganisationStatus.Applied or OrganisationStatus.UnderReview or OrganisationStatus.Suspended
             && User.HasPermission(Permissions.Organisations.Approve))
        {
            <form method="post" @formname="approve" @onsubmit="ApproveAsync">
                <AntiforgeryToken />
                <button type="submit">@T[o.Status == OrganisationStatus.Suspended ? "organiser.org.reinstate" : "organiser.org.approve"]</button>
            </form>
        }
        @if (o.Status is OrganisationStatus.Applied or OrganisationStatus.UnderReview)
        {
            @ReasonForm("changes", T["organiser.request_changes"], T["organiser.org.changes_reason"])
        }
        @if (o.Status is OrganisationStatus.Applied or OrganisationStatus.UnderReview or OrganisationStatus.ChangesRequested or OrganisationStatus.Suspended)
        {
            @ReasonForm("reject", T["organiser.reject"], T["organiser.org.reject_reason"])
        }
        @if (o.Status == OrganisationStatus.Approved && User.HasPermission(Permissions.Organisations.Suspend))
        {
            @ReasonForm("suspend", T["organiser.org.suspend"], T["organiser.org.suspend_reason"])
        }
    </section>

    @if (o.History.Count > 0)
    {
        <section aria-labelledby="history-heading">
            <h2 id="history-heading">@T["organiser.org.history"]</h2>
            <ol class="history">
                @foreach (VettingHistoryRow h in o.History)
                {
                    <li>
                        <time datetime="@h.OccurredAt.ToString("O")">@Local(h.OccurredAt)</time>:
                        @T.Format("organiser.org.history_move", ("from", h.From is null ? T["organiser.org.new"] : StatusWord(h.From)), ("to", StatusWord(h.To)))
                        @if (h.Note is { Length: > 0 } note)
                        {
                            <span>: <q dir="auto">@note</q></span>
                        }
                    </li>
                }
            </ol>
        </section>
    }
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    private OrganisationForReview? _org;
    private string? _problem;
    private readonly Dictionary<string, string> _reasonErrors = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            Navigation.NotFound();
            return;
        }

        _org = await Get<OrganisationReview>().GetAsync(new OrganisationId(OrgId));
        if (_org is null)
        {
            Navigation.NotFound();
        }
    }

    private Task StartReviewAsync() => DecideAsync(OrganisationStatus.UnderReview, null, "started");

    private Task ApproveAsync() => User.HasPermission(Permissions.Organisations.Approve)
        ? DecideAsync(OrganisationStatus.Approved, null, "approved")
        : Refuse();

    private Task RequestChangesAsync() => DecideAsync(OrganisationStatus.ChangesRequested, "changes", "changes_requested");

    private Task RejectAsync() => DecideAsync(OrganisationStatus.Rejected, "reject", "rejected");

    private Task SuspendAsync() => User.HasPermission(Permissions.Organisations.Suspend)
        ? DecideAsync(OrganisationStatus.Suspended, "suspend", "suspended")
        : Refuse();

    private Task Refuse()
    {
        _problem = T["organiser.org.not_allowed"];
        HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        return Task.CompletedTask;
    }

    private async Task DecideAsync(OrganisationStatus to, string? reasonForm, string done)
    {
        string? reason = reasonForm is null ? null : FormValue("reason");
        Result result = await Get<OrganisationReview>().DecideAsync(new OrganisationId(OrgId), to, reason, Actor);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(to == OrganisationStatus.UnderReview
                ? $"/organiser/review/organisations/{OrgId}"
                : $"/organiser/review?done={done}");
            return;
        }

        if (reasonForm is not null && result.Error!.Code == "organisation.reason_required")
        {
            _reasonErrors[reasonForm] = T.Error(result.Error);
        }
        else
        {
            _problem = T.Error(result.Error!);
        }
    }

    private RenderFragment ReasonForm(string formName, string button, string label) => __builder =>
    {
        string id = $"reason-{formName}";
        bool invalid = _reasonErrors.ContainsKey(formName);
        Func<Task> handler = formName switch
        {
            "changes" => RequestChangesAsync,
            "reject" => RejectAsync,
            _ => SuspendAsync,
        };
        <form method="post" class="reason-form" @formname="@formName" @onsubmit="handler">
            <AntiforgeryToken />
            <div class="field">
                <label for="@id">@label</label>
                <textarea id="@id" name="reason" rows="3" aria-invalid="@(invalid ? "true" : null)" aria-describedby="@(invalid ? id + "-error" : null)"></textarea>
                @if (invalid)
                {
                    <p class="field-error" id="@id-error">@_reasonErrors[formName]</p>
                }
            </div>
            <button type="submit" class="secondary-button">@button</button>
        </form>
    };

    private string Local(DateTimeOffset? at) => at is { } t ? T.DateTime(t) : "";

    /// <summary>A status as the history stores it (a database value), in the reader's language.</summary>
    private string StatusWord(string dbValue) =>
        OrganisationStatusExtensions.TryFromDbValue(dbValue, out OrganisationStatus status)
            ? T[BrightTime.Modules.Directory.Vetting.OrganisationVetting.StatusPhrase(status)]
            : dbValue.Replace('_', ' ');
}
