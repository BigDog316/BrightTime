@page "/provider/orgs/{OrgId:guid}/spaces/{SpaceId:guid}"
@using BrightTime.Modules.Community.Contracts
@using BrightTime.Modules.Community.Groups
@using BrightTime.Modules.Community.Moderation
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Modules.Identity.Contracts
@using BrightTime.SharedKernel.Ids
@using BrightTime.SharedKernel.Primitives
@using BrightTime.SharedKernel.Privacy
@using BrightTime.Web.Components.Console.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [YouthRecord(Spaces.Read)]
@inherits ConsoleComponent

@*
    One of the organisation's spaces (D120), for its staff: who is in it, its posts and replies,
    and, for its members, a post or a reply. Those who manage membership choose its staff and
    archive it. Its young people aren't chosen: those enrolled in the activity whose consent allows
    it join once two staff are in it. A post held for a moderator shows only to its author.
    Members report someone else's post to the county's moderators (D121); a post taken down that
    has replies stays as a line saying so, with its replies under it. Its challenges (D122), and,
    for its staff who give feedback, setting one.
*@
@if (Forbidden)
{
    <PageTitle>@T["site.denied.title"] · BrightTime</PageTitle>
    <h1>@T["provider.spaces.denied"]</h1>
    <p>@T["provider.spaces.denied_hint"] <a href="/provider">@T["provider.go_to_organisations"]</a></p>
}
else if (_space is { } s)
{
    <PageTitle>@s.Name · BrightTime</PageTitle>

    <p class="eyebrow"><a href="/provider/orgs/@OrgId/spaces">@T["provider.nav.spaces"]</a></p>
    <h1 dir="auto">@s.Name</h1>
    <OrgNav OrgId="@OrgId" Current="spaces" Role="@(RoleIn(Org) ?? "")" />

    @if (Done is { Length: > 0 } && T.Has("provider.spaces.done." + Done))
    {
        <p class="notice success" role="status">@T["provider.spaces.done." + Done]</p>
    }
    @if (_problem is not null)
    {
        <p class="notice error" role="alert">@_problem</p>
    }

    @if (s.Description is { Length: > 0 } about)
    {
        <p dir="auto">@about</p>
    }
    @if (s.Status == SpaceStatuses.Archived)
    {
        <p class="notice">@T["provider.spaces.archived_notice"]</p>
    }
    <p class="notice">@T["provider.spaces.who_reads"]</p>

    <section aria-labelledby="people">
        <h2 id="people">@T["provider.spaces.people"]</h2>
        <h3>@T["provider.spaces.staff"]</h3>
        <ul class="card-list">
            @foreach (SpaceMemberView m in s.Members.Where(m => m.Role != SpaceRoles.Youth))
            {
                <li>
                    <bdi>@(m.Name ?? T["provider.spaces.staff_member"])</bdi>
                    @if (m.IsMe)
                    {
                        <span class="note">@(" · " + T["provider.spaces.me"])</span>
                    }
                    @if (_canManage && s.Status == SpaceStatuses.Active)
                    {
                        <form method="post" class="inline-form" @formname="@("remove-" + m.UserId.ToString("N"))" @onsubmit="() => RemoveStaffAsync(m.UserId)">
                            <AntiforgeryToken />
                            <button type="submit" class="secondary-button" aria-label="@T.Format("provider.spaces.remove_label", ("name", m.Name ?? ""))">@T["provider.spaces.remove"]</button>
                        </form>
                    }
                </li>
            }
        </ul>
        @if (s.Members.Count(m => m.Role != SpaceRoles.Youth) < Spaces.MinimumStaff)
        {
            <p class="hint">@T.Format("provider.spaces.needs_staff", ("count", Spaces.MinimumStaff))</p>
        }

        <h3>@T["provider.spaces.youth"]</h3>
        @if (!s.Members.Any(m => m.Role == SpaceRoles.Youth))
        {
            <p>@T["provider.spaces.no_youth"]</p>
        }
        else
        {
            <ul class="card-list">
                @foreach (SpaceMemberView m in s.Members.Where(m => m.Role == SpaceRoles.Youth))
                {
                    <li><bdi>@(m.Name ?? T["provider.spaces.unnamed"])</bdi> <span class="note">@T.Format("provider.spaces.joined", ("date", T.DateTime(m.JoinedAt)))</span></li>
                }
            </ul>
        }
        <p class="hint">@T["provider.spaces.youth_hint"]</p>

        @if (_canManage && s.Status == SpaceStatuses.Active && _candidates.Count > 0)
        {
            <form method="post" @formname="add" @onsubmit="AddStaffAsync" class="message-form">
                <AntiforgeryToken />
                <div class="field">
                    <label for="add-staff">@T["provider.spaces.add"]</label>
                    <select id="add-staff" name="person">
                        @foreach ((Guid id, string email) in _candidates)
                        {
                            <option value="@id">@email</option>
                        }
                    </select>
                </div>
                <button type="submit">@T["provider.spaces.add_button"]</button>
            </form>
        }
    </section>

    <section aria-labelledby="challenges">
        <h2 id="challenges">@T["provider.challenges.heading"]</h2>
        @if (_challenges.Count == 0)
        {
            <p>@T["provider.challenges.none"]</p>
        }
        else
        {
            <ul class="card-list">
                @foreach (ChallengeSummary c in _challenges)
                {
                    <li>
                        <a href="/provider/orgs/@OrgId/spaces/@SpaceId/challenges/@c.Id" dir="auto">@c.Title</a>
                        <span class="note">
                            @(" · " + T["provider.challenges.status." + c.Status])
                            @if (c.DueAt is { } due)
                            {
                                @(" · " + T.Format("provider.challenges.due", ("date", T.DateTime(due))))
                            }
                            @(" · " + T.Format("provider.challenges.counts", ("sent", c.Sent), ("waiting", c.Waiting)))
                        </span>
                    </li>
                }
            </ul>
        }

        @if (_canSetChallenges)
        {
            <form method="post" @formname="challenge" @onsubmit="SetChallengeAsync" class="message-form">
                <AntiforgeryToken />
                <h3>@T["provider.challenges.set"]</h3>
                <div class="field">
                    <label for="challenge-title">@T["provider.challenges.title_label"]</label>
                    <input id="challenge-title" name="title" maxlength="@Challenges.MaxTitle" required dir="auto" />
                </div>
                <div class="field">
                    <label for="challenge-brief">@T["provider.challenges.brief_label"]</label>
                    <textarea id="challenge-brief" name="brief" rows="5" maxlength="@Challenges.MaxBrief" required dir="auto"></textarea>
                </div>
                <div class="field">
                    <label for="challenge-due">@T["provider.challenges.due_label"]</label>
                    <input id="challenge-due" name="due" type="date" aria-describedby="challenge-due-hint" />
                    <p class="hint" id="challenge-due-hint">@T["provider.challenges.due_hint"]</p>
                </div>
                <div class="field">
                    <label for="challenge-rubric">@T["provider.challenges.rubric_label"]</label>
                    <select id="challenge-rubric" name="rubric" aria-describedby="challenge-rubric-hint">
                        <option value="">@T["provider.challenges.no_rubric"]</option>
                        @foreach (RubricView r in _rubrics)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                    <p class="hint" id="challenge-rubric-hint">@T["provider.challenges.rubric_hint"]</p>
                </div>
                <button type="submit">@T["provider.challenges.set_button"]</button>
            </form>
        }
    </section>

    <section aria-labelledby="posts">
        <h2 id="posts">@T["provider.spaces.posts"]</h2>
        @if (s.CanPost)
        {
            <form method="post" @formname="post" @onsubmit="() => PostAsync(null)" class="message-form">
                <AntiforgeryToken />
                <div class="field">
                    <label for="post-body">@T["provider.spaces.new_post"]</label>
                    <textarea id="post-body" name="body" rows="4" maxlength="@Spaces.MaxBody" required dir="auto"></textarea>
                </div>
                <button type="submit">@T["provider.spaces.post_button"]</button>
            </form>
        }
        else if (!s.IsMember && s.Status == SpaceStatuses.Active)
        {
            <p class="hint">@T["provider.spaces.not_member"]</p>
        }

        @if (s.Posts.Count == 0)
        {
            <p>@T["provider.spaces.no_posts"]</p>
        }
        else
        {
            <ol class="messages posts">
                @foreach (PostView p in s.Posts)
                {
                    <li class="@(p.FromMe ? "mine" : null)">
                        @Post(p)
                        @if (p.Replies.Count > 0)
                        {
                            <ol class="messages replies">
                                @foreach (PostView r in p.Replies)
                                {
                                    <li class="@(r.FromMe ? "mine" : null)">@Post(r)</li>
                                }
                            </ol>
                        }
                        @if (s.CanPost && p.State == PostStates.Published)
                        {
                            string id = p.Id.ToString("N");
                            <form method="post" @formname="@("reply-" + id)" @onsubmit="() => PostAsync(p.Id)" class="message-form reply-form">
                                <AntiforgeryToken />
                                <div class="field">
                                    <label for="reply-@id">@T["provider.spaces.reply"]</label>
                                    <textarea id="reply-@id" name="body" rows="2" maxlength="@Spaces.MaxBody" required dir="auto"></textarea>
                                </div>
                                <button type="submit">@T["provider.spaces.reply_button"]</button>
                            </form>
                        }
                    </li>
                }
            </ol>
        }
    </section>

    @if (_canManage && s.Status == SpaceStatuses.Active)
    {
        <form method="post" @formname="archive" @onsubmit="ArchiveAsync">
            <AntiforgeryToken />
            <p class="hint">@T["provider.spaces.archive_hint"]</p>
            <button type="submit" class="secondary-button">@T["provider.spaces.archive"]</button>
        </form>
    }
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    [Parameter] public Guid SpaceId { get; set; }

    [SupplyParameterFromQuery(Name = "done")] public string? Done { get; set; }

    private SpaceView? _space;
    private string? _problem;
    private bool _canManage;
    private IReadOnlyList<ChallengeSummary> _challenges = [];
    private bool _canSetChallenges;
    private IReadOnlyList<RubricView> _rubrics = [];

    /// <summary>Adult members of the organisation's staff not yet in the space, by email.</summary>
    private IReadOnlyList<(Guid Id, string Email)> _candidates = [];

    private OrganisationId Org => new(OrgId);

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            Navigation.NotFound();
            return;
        }

        if (!await CanActForAsync(Org, Permissions.Spaces.View))
        {
            Forbid();
            return;
        }

        Result<SpaceView> found = await Get<Spaces>().GetForOrganisationAsync(Org, Actor, SpaceId);
        if (!found.IsSuccess)
        {
            Navigation.NotFound();
            return;
        }

        _space = found.Value;
        _canManage = await CanActForAsync(Org, Permissions.Spaces.ManageMembership);
        _challenges = await Get<Challenges>().ListForOrganisationAsync(Org, Actor, SpaceId) is { IsSuccess: true } listed ? listed.Value : [];
        _canSetChallenges = _space.IsMember && _space.Status == SpaceStatuses.Active
            && _space.Members.Any(m => m.IsMe && m.Role != SpaceRoles.Youth)
            && await CanActForAsync(Org, Permissions.Submissions.GiveFeedback);
        if (_canSetChallenges)
        {
            _rubrics = await Get<Rubrics>().ListAsync(Org, includeArchived: false);
        }

        if (_canManage)
        {
            HashSet<Guid> inIt = [.. _space.Members.Select(m => m.UserId)];
            List<Guid> others = [.. (await Get<IDirectoryQueries>().GetOrganisationMembersAsync(Org)).Select(m => m.UserId.Value).Where(u => !inIt.Contains(u))];
            IReadOnlyDictionary<Guid, string> emails = await Get<IIdentityQueries>().GetAdultEmailsAsync(others);
            _candidates = [.. emails.OrderBy(e => e.Value, StringComparer.OrdinalIgnoreCase).Select(e => (e.Key, e.Value))];
        }
    }

    private RenderFragment Post(PostView p) => __builder =>
    {
        @* Taken down, but its replies are still here: say so, and nothing of what it said. *@
        if (p.State == PostStates.DeletedByAuthor || (p.State == PostStates.Removed && !p.FromMe))
        {
            <p class="note">@T[p.State == PostStates.DeletedByAuthor ? "provider.spaces.taken_down_placeholder" : "provider.spaces.removed_placeholder"]</p>
            return;
        }

        <p class="note">
            @Author(p) · @T.DateTime(p.At)
            @if (p.State == PostStates.Held)
            {
                <strong>@(" · " + T["provider.spaces.held"])</strong>
            }
            else if (p.State == PostStates.Removed)
            {
                <strong>@(" · " + T["provider.spaces.removed"])</strong>
            }
        </p>
        <p class="body" dir="auto">@p.Body</p>
        @if (p.FromMe && p.State is PostStates.Published or PostStates.Held)
        {
            <form method="post" class="inline-form" @formname="@("delete-" + p.Id.ToString("N"))" @onsubmit="() => DeleteAsync(p.Id)">
                <AntiforgeryToken />
                <button type="submit" class="secondary-button">@T["provider.spaces.delete"]</button>
            </form>
        }
        @if (!p.FromMe && p.State == PostStates.Published && _space is { IsMember: true })
        {
            string id = p.Id.ToString("N");
            <details class="report-form">
                <summary>@T["provider.spaces.report"]</summary>
                <form method="post" class="reason-form" @formname="@("report-" + id)" @onsubmit="() => ReportAsync(p.Id)">
                    <AntiforgeryToken />
                    <div class="field">
                        <label for="report-reason-@id">@T["provider.spaces.report.why"]</label>
                        <select id="report-reason-@id" name="reason" required>
                            @foreach (string reason in ReportReasons.ForMessages)
                            {
                                <option value="@reason">@T["moderation.report_reason." + reason]</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="report-details-@id">@T["provider.spaces.report.details"]</label>
                        <textarea id="report-details-@id" name="details" rows="2" maxlength="@Reports.MaxDetails" dir="auto"></textarea>
                    </div>
                    <p class="hint">@T["provider.spaces.report.danger"]</p>
                    <button type="submit">@T["provider.spaces.report.send"]</button>
                </form>
            </details>
        }
    };

    private async Task SetChallengeAsync()
    {
        if (!_canSetChallenges)
        {
            Forbid();
            return;
        }

        DateTimeOffset? due = null;
        if (DateOnly.TryParse(FormValue("due"), System.Globalization.CultureInfo.InvariantCulture, out DateOnly day))
        {
            // The end of the day it names, in the county's time.
            DateTime midnight = day.AddDays(1).ToDateTime(TimeOnly.MinValue);
            due = new DateTimeOffset(midnight, Tenant.TimeZone.GetUtcOffset(midnight)).ToUniversalTime();
        }

        Guid? rubric = Guid.TryParse(FormValue("rubric"), out Guid chosen) ? chosen : null;
        Result<Guid> set = await Get<Challenges>().SetAsync(Actor, SpaceId, FormValue("title"), FormValue("brief"), due, rubric);
        if (!set.IsSuccess)
        {
            _problem = T.Error(set.Error);
            return;
        }

        Navigation.NavigateTo($"/provider/orgs/{OrgId}/spaces/{SpaceId}/challenges/{set.Value}?done=set");
    }

    private async Task ReportAsync(Guid post)
    {
        string details = FormValue("details");
        Result<ReportReceipt> made = await Get<Reports>().ReportPostAsync(Actor, post, FormValue("reason"), string.IsNullOrWhiteSpace(details) ? null : details);
        if (!made.IsSuccess)
        {
            _problem = T.Error(made.Error);
            return;
        }

        Navigation.NavigateTo($"/provider/orgs/{OrgId}/spaces/{SpaceId}?done={(made.Value.Severity == ReportSeverities.Critical ? "reported_critical" : "reported")}");
    }

    private string Author(PostView p) =>
        p.FromMe ? T["provider.spaces.me"]
        : p.AuthorRole == SpaceRoles.Youth ? p.AuthorName ?? T["provider.spaces.unnamed"]
        : p.AuthorName ?? T["provider.spaces.staff_member"];

    private async Task PostAsync(Guid? replyTo)
    {
        Result<PostView> posted = await Get<Spaces>().PostAsync(Actor, SpaceId, FormValue("body"), replyTo);
        if (!posted.IsSuccess)
        {
            _problem = T.Error(posted.Error);
            return;
        }

        Navigation.NavigateTo($"/provider/orgs/{OrgId}/spaces/{SpaceId}?done={(posted.Value.State == PostStates.Held ? "held" : "posted")}");
    }

    private async Task DeleteAsync(Guid post) => Finish(await Get<Spaces>().DeleteAsync(Actor, SpaceId, post), "deleted");

    private async Task AddStaffAsync()
    {
        if (!_canManage)
        {
            Forbid();
            return;
        }

        if (!Guid.TryParse(FormValue("person"), out Guid person))
        {
            return;
        }

        Finish(await Get<Spaces>().AddStaffAsync(Org, Actor, SpaceId, new UserId(person)), "added");
    }

    private async Task RemoveStaffAsync(Guid person)
    {
        if (!_canManage)
        {
            Forbid();
            return;
        }

        Finish(await Get<Spaces>().RemoveStaffAsync(Org, Actor, SpaceId, new UserId(person)), "removed");
    }

    private async Task ArchiveAsync()
    {
        if (!_canManage)
        {
            Forbid();
            return;
        }

        Result archived = await Get<Spaces>().ArchiveAsync(Org, Actor, SpaceId);
        if (archived.IsSuccess)
        {
            Navigation.NavigateTo($"/provider/orgs/{OrgId}/spaces?done=archived");
            return;
        }

        _problem = T.Error(archived.Error!);
    }

    private void Finish(Result result, string done)
    {
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/provider/orgs/{OrgId}/spaces/{SpaceId}?done={done}");
            return;
        }

        _problem = T.Error(result.Error!);
    }
}
