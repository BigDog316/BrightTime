@page "/portfolio/projects/new"
@page "/portfolio/projects/{Id:guid}"
@* Writes or changes a project (D69, D78): what it is, in words, and the activity it came from,
   whose organisation approves it. Changing one that was sent, approved or shown makes it a private
   draft again: the screen says so before it's saved. A saved project takes up to six pictures
   (D104), each saying what it shows; adding one makes it a draft again, taking one away doesn't. *@
@inject BrightTimeApi Api
@inject AppSession Session
@inject NavigationManager Navigation

<h1>@T[Id is null ? "app.projects.add" : "app.projects.change_title"]</h1>

@if (Session.Me is not { } me || !Portfolio.HasPortfolio(me))
{
    <p>@T["app.portfolio.youth_only"]</p>
}
else if (!_ready && _problem is null)
{
    <Busy />
}
else if (!_ready)
{
    <ProblemNotice Problem="_problem" Retry="LoadAsync" />
}
else if (_missing)
{
    <p>@T["error.projects.not_found"]</p>
    <a class="button" href="portfolio/projects">@T["app.projects.back"]</a>
}
else
{
    @if (_project is { Status: not "draft" })
    {
        <p><strong>@T["app.projects.change_warning"]</strong></p>
    }
    <form class="stack" @onsubmit="SaveAsync">
        <div class="field">
            <label for="project-title">@T["app.projects.project_title"]</label>
            <input id="project-title" required maxlength="200" autocomplete="off" dir="auto" @bind="_title" />
        </div>
        <div class="field">
            <label for="project-text">@T["app.projects.description"]</label>
            <p class="hint" id="project-text-hint">@T["app.projects.description_hint"]</p>
            <textarea id="project-text" rows="8" maxlength="10000" dir="auto" @bind="_description" aria-describedby="project-text-hint"></textarea>
        </div>
        <div class="field">
            <label for="project-activity">@T["app.projects.activity"]</label>
            <p class="hint" id="project-activity-hint">@T[_activities.Count == 0 ? "app.projects.no_activities" : "app.projects.activity_hint"]</p>
            <select id="project-activity" @bind="_listing" aria-describedby="project-activity-hint">
                <option value="">@T["app.projects.activity_none"]</option>
                @foreach (ParticipationView a in _activities)
                {
                    <option value="@a.ListingId!.Value.ToString("D")">@(a.Organisation is { Length: > 0 } org ? a.Title + " · " + org : a.Title)</option>
                }
            </select>
        </div>
        <ProblemNotice Problem="_problem" />
        <div class="actions">
            <button type="submit" class="primary" disabled="@_busy">@T["app.projects.save"]</button>
            <a class="button" href="portfolio/projects">@T["app.projects.back"]</a>
        </div>
    </form>

    <section class="stack" aria-labelledby="pictures-heading">
        <h2 id="pictures-heading">@T["app.projects.pictures"]</h2>
        @if (_project is not { } saved)
        {
            <p class="hint">@T["app.projects.pictures_after_save"]</p>
        }
        else
        {
            @if (_pictureSaid is { Length: > 0 } said)
            {
                <p class="notice" role="status">@said</p>
            }
            @if (saved.Shown.Count > 0)
            {
                <ul class="cards">
                    @foreach (ProjectPicture picture in saved.Shown)
                    {
                        <li class="card" @key="picture.MediaId">
                            <ProjectPictureImage ProjectId="saved.Id" Picture="picture" />
                            <button type="button" disabled="@_busy" @onclick="() => RemovePictureAsync(picture)">@T["app.projects.picture_remove"]</button>
                        </li>
                    }
                </ul>
            }
            @if (saved.Shown.Count >= MaxPictures)
            {
                <p class="hint">@T["app.projects.pictures_full"]</p>
            }
            else
            {
                <form class="stack" @onsubmit="AddPictureAsync">
                    <p class="hint">@T["app.projects.pictures_hint"]</p>
                    @if (saved.Status != "draft")
                    {
                        <p><strong>@T["app.projects.picture_warning"]</strong></p>
                    }
                    <div class="field">
                        <label for="picture-file">@T["app.projects.picture_file"]</label>
                        <InputFile id="picture-file" accept="image/png,image/jpeg" OnChange="Pick" />
                    </div>
                    <div class="field">
                        <label for="picture-alt">@T["app.projects.picture_alt"]</label>
                        <p class="hint" id="picture-alt-hint">@T["app.projects.picture_alt_hint"]</p>
                        <input id="picture-alt" required maxlength="250" autocomplete="off" dir="auto" @bind="_alt" aria-describedby="picture-alt-hint" />
                    </div>
                    <div class="field">
                        <label for="picture-caption">@T["app.projects.picture_caption"]</label>
                        <input id="picture-caption" maxlength="300" autocomplete="off" dir="auto" @bind="_caption" />
                    </div>
                    <ProblemNotice Problem="_pictureProblem" />
                    <div class="actions">
                        <button type="submit" class="primary" disabled="@(_busy || _file is null)">@T["app.projects.picture_add"]</button>
                    </div>
                </form>
            }
        }
    </section>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private IReadOnlyList<ParticipationView> _activities = [];
    private ProjectView? _project;
    private ApiProblem? _problem;
    private bool _ready;
    private bool _missing;
    private bool _busy;

    private string _title = "";
    private string _description = "";
    private string _listing = "";

    /// <summary>As the server holds them (D104): six pictures of up to 5 MB.</summary>
    private const int MaxPictures = 6;
    private const long MaxPictureBytes = 5 * 1024 * 1024;

    private (byte[] Bytes, string Type)? _file;
    private string _alt = "";
    private string _caption = "";
    private ApiProblem? _pictureProblem;
    private string? _pictureSaid;

    protected override Task OnInitializedAsync() => Session.Me is { } me && Portfolio.HasPortfolio(me) ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        _problem = null;
        ApiResult<PortfolioView> portfolio = await Api.PortfolioAsync();
        if (portfolio.Problem is { } problem)
        {
            _problem = problem;
            return;
        }

        // An activity is one the young person took part in, through this platform: a record with a
        // listing. One taken part in more than once is offered once.
        _activities = [.. portfolio.Value!.Participation.Where(r => r.ListingId is not null).DistinctBy(r => r.ListingId)];
        if (Id is { } id)
        {
            ApiResult<IReadOnlyList<ProjectView>> projects = await Api.ProjectsAsync();
            if (projects.Problem is { } failed)
            {
                _problem = failed;
                return;
            }

            _project = projects.Value!.FirstOrDefault(p => p.Id == id);
            if (_project is { } project)
            {
                _title = project.Title;
                _description = project.Description ?? "";
                _listing = project.ListingId?.ToString("D") ?? "";
            }
            else
            {
                _missing = true;
            }
        }

        _ready = true;
    }

    /// <summary>
    /// The chosen file, read now. Only a PNG or JPEG of up to 5 MB is read at all; the server
    /// looks at the bytes themselves, whatever the file says it is.
    /// </summary>
    private async Task Pick(InputFileChangeEventArgs e)
    {
        _file = null;
        _pictureProblem = null;
        IBrowserFile picked = e.File;
        if (picked.ContentType is not ("image/png" or "image/jpeg") || picked.Size is 0 or > MaxPictureBytes)
        {
            _pictureProblem = new ApiProblem(ApiProblem.Prefix + "projects.picture", null, 422);
            return;
        }

        byte[] bytes = new byte[picked.Size];
        await using Stream read = picked.OpenReadStream(MaxPictureBytes);
        await read.ReadExactlyAsync(bytes);
        _file = (bytes, picked.ContentType);
    }

    private async Task AddPictureAsync()
    {
        if (_project is not { } project || _file is not { } file)
        {
            return;
        }

        _busy = true;
        _pictureSaid = null;
        ApiResult<ProjectView> added = await Api.AddProjectPictureAsync(project.Id, file.Bytes, file.Type, _alt.Trim(), _caption.Trim() is { Length: > 0 } c ? c : null);
        _pictureProblem = added.Problem;
        if (added.Value is { } now)
        {
            _project = now;
            _file = null;
            _alt = "";
            _caption = "";
            _pictureSaid = T["app.projects.picture_added"];
        }

        _busy = false;
    }

    private async Task RemovePictureAsync(ProjectPicture picture)
    {
        if (_project is not { } project)
        {
            return;
        }

        _busy = true;
        _pictureSaid = null;
        ApiResult<ProjectView> removed = await Api.RemoveProjectPictureAsync(project.Id, picture.MediaId);
        _pictureProblem = removed.Problem;
        if (removed.Value is { } now)
        {
            _project = now;
            _pictureSaid = T["app.projects.picture_removed"];
        }

        _busy = false;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        ProjectDraft draft = new(_title.Trim(), _description.Trim() is { Length: > 0 } d ? d : null, Guid.TryParse(_listing, out Guid l) ? l : null);
        ApiResult<ProjectView> saved = Id is { } id ? await Api.ChangeProjectAsync(id, draft) : await Api.AddProjectAsync(draft);
        _problem = saved.Problem;
        _busy = false;
        if (saved.Value is not null)
        {
            Navigation.NavigateTo("portfolio/projects");
        }
    }
}
