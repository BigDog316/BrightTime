@page "/provider"
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.SharedKernel.Ids
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits ConsoleComponent

<PageTitle>@T["site.nav.organisations"] · BrightTime</PageTitle>

<h1>@T["site.nav.organisations"]</h1>

@if (!Availability.IsAvailable)
{
    <p>@T["provider.no_database"]</p>
}
else if (_organisations.Count == 0)
{
    <p>@T["provider.no_organisations"]</p>
}
else
{
    <ul class="card-list">
        @foreach (var (id, name, role, status) in _organisations)
        {
            <li>
                <a href="/provider/orgs/@id.Value">@name</a>
                <span class="note">@T.Format("provider.membership", ("role", T["organisation.role." + role]), ("status", T[BrightTime.Modules.Directory.Vetting.OrganisationVetting.StatusPhrase(status)]))</span>
            </li>
        }
    </ul>
}

@if (User.HasPermission(Permissions.Listings.Review))
{
    <p><a href="/organiser/review">@T["provider.go_to_review"]</a></p>
}

@code {
    private List<(OrganisationId Id, string Name, string Role, OrganisationStatus Status)> _organisations = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            return;
        }

        IDirectoryQueries directory = Get<IDirectoryQueries>();
        foreach (var claim in User.FindAll(BrightTimeClaims.OrganisationMembership))
        {
            if (BrightTimeClaims.TryParseMembership(claim.Value, out Guid orgId, out string role))
            {
                OrganisationId id = new(orgId);
                string? name = await directory.GetOrganisationNameAsync(id);
                OrganisationStatus? status = await directory.GetStatusAsync(id);
                if (name is not null && status is not null)
                {
                    _organisations.Add((id, name, role, status.Value));
                }
            }
        }

        _organisations.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.CurrentCulture));
    }
}
