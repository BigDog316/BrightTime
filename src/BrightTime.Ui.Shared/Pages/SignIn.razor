@page "/sign-in"
@* A passkey first where the phone has them (D38; T21 prefers them), then email and password
   (D28's token endpoint). A forgotten password is asked for here; its link opens the web's page. *@
@inject AppSession Session
@inject IPasskeyAuthenticator Passkey
@inject IExternalAuthenticator Browser
@inject BrightTimeApi Api
@inject AppEndpoints Endpoints
@inject NavigationManager Navigation

<h1>@T["account.sign_in.title"]</h1>

@if (_problem is not null)
{
    <p class="notice error" role="alert" id="sign-in-error">@_problem</p>
}

@if (Passkey.IsSupported)
{
    <div class="actions">
        <button type="button" class="primary" @onclick="PasskeyAsync" disabled="@_busy">@T["account.sign_in.with_passkey"]</button>
    </div>
    <p>@T["account.sign_in.or_password"]</p>
}

@if (Browser.IsSupported && _providers.Count > 0)
{
    <div class="actions">
        @foreach (ExternalProvider provider in _providers)
        {
            <button type="button" @onclick="() => ExternalAsync(provider)" disabled="@_busy">@T.Format("account.sign_in.with_provider", ("provider", Text.Name(provider.Name)))</button>
        }
    </div>
}

<form class="stack" @onsubmit="SignInAsync">
    <div class="field">
        <label for="email">@T["account.field.email"]</label>
        <input id="email" type="email" autocomplete="username" inputmode="email" required @bind="_email"
               aria-describedby="@(_problem is null ? null : "sign-in-error")" />
    </div>
    <div class="field">
        <label for="password">@T["account.field.password"]</label>
        <input id="password" type="password" autocomplete="current-password" required @bind="_password" />
    </div>
    <div class="actions">
        <button type="submit" class="@(Passkey.IsSupported ? "" : "primary")" disabled="@_busy">@T["account.sign_in.submit"]</button>
    </div>
</form>

<p><a href="forgot">@T["account.sign_in.forgot"]</a></p>
<p>@T["app.sign_in.no_account"] <a href="register">@T["app.account.create"]</a></p>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string _email = "";
    private string _password = "";
    private string? _problem;
    private bool _busy;

    private async Task SignInAsync()
    {
        _busy = true;
        ApiProblem? failed = await Session.SignInAsync(_email.Trim(), _password);
        _busy = false;
        if (failed is not null)
        {
            // A wrong password and an unknown address read the same (T21).
            _problem = failed.Type is ApiProblem.OfflineType ? Words.Problem(T, failed) : T["app.sign_in.failed"];
            return;
        }

        _password = "";
        Back();
    }

    private IReadOnlyList<ExternalProvider> _providers = [];

    protected override async Task OnInitializedAsync()
    {
        if (Browser.IsSupported && await Api.ExternalProvidersAsync() is { Value: { } providers })
        {
            _providers = providers;
        }
    }

    // The provider's flow runs on the web in the system browser (D41); only an account already
    // connected to it signs in, and connecting happens on the web.
    private async Task ExternalAsync(ExternalProvider provider)
    {
        _busy = true;
        _problem = null;
        ApiProblem? failed = await Session.SignInExternallyAsync(Browser, Endpoints, provider.Key);
        _busy = false;
        if (failed is null)
        {
            Back();
        }
        else if (failed != AppSession.PasskeyDeclined)
        {
            _problem = failed switch
            {
                { Type: ApiProblem.OfflineType } => Words.Problem(T, failed),
                // A problem code, not a catalogue key: kept off the localising line below.
                { Code: "external.unconnected" } =>
                    T.Format("account.external.unconnected", ("provider", Text.Name(provider.Name))),
                _ => T["account.external.failed"],
            };
        }
    }

    private async Task PasskeyAsync()
    {
        _busy = true;
        _problem = null;
        ApiProblem? failed = await Session.SignInWithPasskeyAsync(Passkey);
        _busy = false;
        if (failed is null)
        {
            Back();
        }
        else if (failed != AppSession.PasskeyDeclined)
        {
            _problem = failed.Type is ApiProblem.OfflineType ? Words.Problem(T, failed) : T["account.passkey.sign_in_failed"];
        }
    }

    // Only a path inside the app: never a link elsewhere.
    private void Back() =>
        Navigation.NavigateTo(ReturnUrl is { Length: > 1 } back && back[0] == '/' && back[1] != '/' ? back : "/");
}
