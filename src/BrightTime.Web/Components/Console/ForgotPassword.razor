@page "/account/forgot"
@using BrightTime.Web.Auth
@inherits ConsoleComponent

<PageTitle>Reset your password · BrightTime</PageTitle>

<h1>Reset your password</h1>

@if (!Availability.CanSignIn)
{
    <p>Accounts are not available on this site yet.</p>
}
else if (Sent == "1")
{
    @* The same words whether or not an account uses the address (T21). *@
    <p class="notice success" role="status">
        If an account uses that address, we've sent it a link to choose a new password. The link works for
        @((int)BrightTime.Modules.Identity.SignIn.PasswordAccounts.ResetLifetime.TotalMinutes) minutes.
        Check your spam folder if it hasn't arrived in a few minutes.
    </p>
    <p><a href="/sign-in">Back to sign in</a></p>
}
else
{
    <p>Enter the email address you sign in with. We'll send a link to choose a new password.</p>
    <form method="post" class="editor sign-in" @formname="forgot" @onsubmit="RequestAsync">
        <AntiforgeryToken />
        <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" required />
        </div>
        <div class="actions">
            <button type="submit">Send the link</button>
            <a class="secondary" href="/sign-in">Back to sign in</a>
        </div>
    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "sent")] public string? Sent { get; set; }

    private Task RequestAsync()
    {
        string email = FormValue("email").Trim();
        if (Availability.CanSignIn && email.Length is > 0 and <= 320 && Get<BrightTime.Web.Tenancy.SiteContext>().BaseUrl is { } siteUrl)
        {
            // Queued, not done here: see PasswordResetDispatcher. The link is built from the
            // tenant's own address, never the Host header.
            Get<PasswordResetDispatcher>().Request(Tenant.TenantId, email, siteUrl);
        }

        Navigation.NavigateTo("/account/forgot?sent=1");
        return Task.CompletedTask;
    }
}
