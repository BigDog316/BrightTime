<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    What the web and API hosts share: tenant resolution by host, the signed-in principal,
    the client's address behind the proxy, the audit trail's request side, health checks,
    the interface's words for a request (Text over the shared catalogue, with the tenant's
    overrides from the database), and account mail.
    A library with the web SDK for its implicit ASP.NET Core usings; it has no entry point.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../BrightTime.Infrastructure/BrightTime.Infrastructure.csproj" />
    <ProjectReference Include="../BrightTime.Localisation/BrightTime.Localisation.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Platform/BrightTime.Modules.Platform.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Identity/BrightTime.Modules.Identity.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Directory.Contracts/BrightTime.Modules.Directory.Contracts.csproj" />
  </ItemGroup>

</Project>
