@* The tabs across an organisation's console pages. Each tab shows only to those who can use it. *@
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.SharedKernel.Ids
<nav class="org-nav" aria-label="@T["provider.nav.label"]">
    <ul>
        @foreach (var (key, path, show) in Tabs)
        {
            @if (show)
            {
                <li><a href="@($"/provider/orgs/{OrgId}{path}")" aria-current="@(Current == key ? "page" : null)">@T["provider.nav." + key]</a></li>
            }
        }
    </ul>
</nav>
@if (_refusal is { } r)
{
    @* The county's clearance rules (D99): why the young people's pages are closed to this person here. *@
    <p class="notice warning" role="status">
        @T["clearances.gate.closed"]
        @if (r.Missing.Count > 0)
        {
            @(" ")@T.Format("clearances.missing", ("kinds", Kinds(r.Missing)))@(".")
        }
        @if (r.Expired.Count > 0)
        {
            @(" ")@T.Format("clearances.expired", ("kinds", Kinds(r.Expired)))@(".")
        }
        @(" ")@T["clearances.gate.ask"]
    </p>
}

@code {
    [Parameter, EditorRequired] public Guid OrgId { get; set; }

    /// <summary>listings, profile, sites, staff, import, forms, applications, attendance, payments, messages, spaces, work or reports.</summary>
    [Parameter, EditorRequired] public string Current { get; set; } = "listings";

    /// <summary>The signed-in person's role in this organisation.</summary>
    [Parameter, EditorRequired] public string Role { get; set; } = "";

    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

    private bool IsAdmin => Role is OrganisationRoles.Owner or OrganisationRoles.Admin;

    private ClearanceRefusal? _refusal;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext.RequestServices.GetService<IClearanceGate>() is { } gate && HttpContext.User.GetUserId() is { } user)
        {
            _refusal = await gate.CheckAsync(new UserId(user), new OrganisationId(OrgId), HttpContext.RequestAborted);
        }
    }

    private string Kinds(IEnumerable<string> kinds) => string.Join(", ", kinds.Select(k => T["clearance.kind." + k]));

    private IEnumerable<(string Key, string Path, bool Show)> Tabs =>
    [
        ("listings", "", true),
        ("profile", "/profile", true),
        ("sites", "/sites", true),
        ("staff", "/staff", true),
        ("import", "/import", IsAdmin && HttpContext.User.HasPermission(Permissions.Listings.BulkImport)),
        ("forms", "/forms", IsAdmin && HttpContext.User.HasPermission(Permissions.Organisations.Edit)),
        ("applications", "/applications", HttpContext.User.HasPermission(Permissions.Applications.View)),
        ("attendance", "/attendance", HttpContext.User.HasPermission(Permissions.Attendance.ViewRoster)),
        ("payments", "/payments", IsAdmin && HttpContext.User.HasPermission(Permissions.Payments.Waive)),
        ("messages", "/messages", HttpContext.User.HasPermission(Permissions.Messages.SendToFamily)),
        ("spaces", "/spaces", HttpContext.User.HasPermission(Permissions.Spaces.View)),
        ("playlists", "/playlists", HttpContext.User.HasPermission(Permissions.Playlists.Author)),
        ("badges", "/badges", HttpContext.User.HasPermission(Permissions.Badges.Define) || HttpContext.User.HasPermission(Permissions.Badges.Issue) || HttpContext.User.HasPermission(Permissions.Badges.Revoke)),
        ("work", "/work", HttpContext.User.HasPermission(Permissions.Projects.Review) || HttpContext.User.HasPermission(Permissions.Playlists.ReviewSteps)),
        ("showcase", "/showcase", HttpContext.User.HasPermission(Permissions.Showcase.Approve)),
        ("reports", "/reports", HttpContext.User.HasPermission(Permissions.Reports.RunProvider)),
    ];
}
