@page "/sign-in"
@using System.Security.Claims
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Modules.Identity.SignIn
@using BrightTime.SharedKernel.Ids
@using BrightTime.Infrastructure.Auditing
@using BrightTime.Web.Auditing
@using BrightTime.Web.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inherits ConsoleComponent

<PageTitle>@T["account.sign_in.title"] · BrightTime</PageTitle>

<h1>@T["account.sign_in.title"]</h1>

@if (!Availability.CanSignIn)
{
    <p>@T[Availability.HasDatabase ? "account.unavailable" : "account.sample_data"]</p>
}
else
{
    @if (User.Identity?.IsAuthenticated == true && !IsPost)
    {
        <p class="notice" role="status">@T.Format("account.sign_in.already", ("name", Localisation.Text.Name(User.Identity.Name ?? ""))) <a href="/provider">@T["provider.go_to_organisations"]</a></p>
    }
    @if (ExternalMessage is { } externalMessage)
    {
        <p class="notice error" role="alert">@externalMessage</p>
    }
    @if (Reset == "1")
    {
        <p class="notice success" role="status">@T["account.sign_in.password_changed"]</p>
    }
    @if (_failed)
    {
        @* One message for every failure, so it never says whether the email is registered (T21). *@
        <p class="notice error" role="alert" id="sign-in-error">
            @T.Format("account.sign_in.failed", ("tries", BrightTime.Modules.Identity.SignIn.PasswordAccounts.MaxFailedAttempts), ("minutes", (int)BrightTime.Modules.Identity.SignIn.PasswordAccounts.LockoutDuration.TotalMinutes))
            <a href="/account/forgot">@T["account.sign_in.reset_link"]</a>
        </p>
    }

    @if (Providers.Count > 0)
    {
        <section aria-labelledby="external-heading" class="external-providers">
            <h2 id="external-heading" class="visually-hidden">@T["account.sign_in.external_heading"]</h2>
            @foreach (var (key, provider) in Providers)
            {
                <form method="post" action="@BrightTime.Web.Auth.ExternalSignIn.StartPath">
                    <AntiforgeryToken />
                    <input type="hidden" name="provider" value="@key" />
                    @if (ReturnUrl is not null)
                    {
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    }
                    <button type="submit" class="secondary-button">@T.Format("account.sign_in.with_provider", ("provider", Localisation.Text.Name(provider.DisplayName)))</button>
                </form>
            }
        </section>
    }

    <section class="needs-webauthn" aria-labelledby="passkey-heading">
        <h2 id="passkey-heading" class="visually-hidden">@T["account.sign_in.with_passkey"]</h2>
        <p class="notice error" id="passkey-error" role="alert" tabindex="-1" hidden></p>
        <button type="button" data-passkey-action="sign-in" data-return-url="@ReturnUrl">@T["account.sign_in.with_passkey"]</button>
        <p class="or-divider">@T["account.sign_in.or_password"]</p>
    </section>

    <form method="post" class="editor sign-in" @formname="sign-in" @onsubmit="SignInAsync">
        <AntiforgeryToken />
        <div class="field">
            <label for="email">@T["account.field.email"]</label>
            <input id="email" name="email" type="email" autocomplete="username" required value="@_email"
                   aria-describedby="@(_failed ? "sign-in-error" : null)" />
        </div>
        <div class="field">
            <label for="password">@T["account.field.password"]</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <div class="actions">
            <button type="submit">@T["account.sign_in.submit"]</button>
            <a class="secondary" href="/account/forgot">@T["account.sign_in.forgot"]</a>
        </div>
    </form>

    @if (Availability.DevelopmentSignIn)
    {
        <p class="note">@T["dev.sign_in.note"] <a href="@DevHref">@T["dev.sign_in.link"]</a></p>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "reset")] public string? Reset { get; set; }

    [SupplyParameterFromQuery(Name = "external")] public string? External { get; set; }

    [SupplyParameterFromQuery(Name = "provider")] public string? ExternalProvider { get; set; }

    [Inject] private Microsoft.Extensions.Options.IOptions<AuthOptions> AuthSettings { get; set; } = default!;

    private IReadOnlyDictionary<string, ExternalProviderOptions> Providers => AuthSettings.Value.External;

    private string? ExternalMessage => External switch
    {
        // Says nothing about whether a BrightTime account exists for that person (D17, T21).
        "unconnected" => T.Format("account.external.unconnected", ("provider", Localisation.Text.Name(ProviderName))),
        "cancelled" => T["account.external.cancelled"],
        "failed" => T["account.external.failed"],
        _ => null,
    };

    private string ProviderName =>
        ExternalProvider is not null && Providers.TryGetValue(ExternalProvider, out ExternalProviderOptions? p) ? p.DisplayName : T["account.external.other_provider"];

    private string? _email;
    private bool _failed;

    private string DevHref => ReturnUrl is null ? "/dev/sign-in" : $"/dev/sign-in?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private async Task SignInAsync()
    {
        if (!Availability.CanSignIn)
        {
            return;
        }

        _email = FormValue("email").Trim();
        string password = FormValue("password");

        PasswordCheckOutcome outcome = await Get<PasswordAccounts>().CheckPasswordWithOutcomeAsync(Tenant.TenantId, _email, password, HttpContext.RequestAborted);
        UserId? user = outcome.SignedIn;
        AuditTrail audit = Get<AuditTrail>();
        ClaimsPrincipal? principal = user is { } id
            ? await Get<BrightTimePrincipalFactory>().CreateAsync(
                Tenant.TenantId, id, new AuthenticationEvent(AuthenticationMethods.Password, Get<BrightTime.SharedKernel.Time.IClock>().UtcNow), HttpContext.RequestAborted)
            : null;

        if (principal is null)
        {
            audit.Record(AuthAudit.Refused(AuthAudit.SignIn, outcome.Account, outcome.Failure ?? "account_not_eligible", AuthenticationMethods.Password));
            _failed = true;
            return;
        }

        audit.Record(AuthAudit.Allowed(AuthAudit.SignIn, user, AuthenticationMethods.Password));
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
        Navigation.NavigateTo(ConsoleServices.LocalReturnPath(ReturnUrl, principal));
    }
}
