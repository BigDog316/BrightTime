@page "/forgot"
@* "Forgot your password?" from the app: the same answer for every address (T21), and a link by
   email to choose a new password, which opens the web's page. *@
@inject BrightTimeApi Api

<h1>@T["account.forgot.title"]</h1>

@if (_sent)
{
    <p class="notice success" role="status">@T.Format("account.forgot.sent", ("minutes", LinkMinutes))</p>
    <a class="button" href="sign-in">@T["account.back_to_sign_in"]</a>
}
else
{
    <p>@T["account.forgot.intro"]</p>
    <form class="stack" @onsubmit="SendAsync">
        <div class="field">
            <label for="email">@T["account.field.email"]</label>
            <input id="email" type="email" autocomplete="username" inputmode="email" required @bind="_email" />
        </div>
        <ProblemNotice Problem="_problem" />
        <div class="actions">
            <button type="submit" class="primary" disabled="@_busy">@T["account.forgot.submit"]</button>
            <a class="button" href="sign-in">@T["account.back_to_sign_in"]</a>
        </div>
    </form>
}

@code {
    // How long a reset link works: the server's PasswordAccounts.ResetLifetime.
    private const int LinkMinutes = 60;

    private string _email = "";
    private bool _sent;
    private bool _busy;
    private ApiProblem? _problem;

    private async Task SendAsync()
    {
        _busy = true;
        ApiResult asked = await Api.ForgotPasswordAsync(_email.Trim());
        _busy = false;
        _sent = asked.IsSuccess;
        _problem = asked.Problem;
    }
}
