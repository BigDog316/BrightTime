@page "/account/forgot"
@using BrightTime.Web.Auth
@inherits ConsoleComponent

<PageTitle>@T["account.forgot.title"] · BrightTime</PageTitle>

<h1>@T["account.forgot.title"]</h1>

@if (!Availability.CanSignIn)
{
    <p>@T["account.unavailable"]</p>
}
else if (Sent == "1")
{
    @* The same words whether or not an account uses the address (T21). *@
    <p class="notice success" role="status">
        @T.Format("account.forgot.sent", ("minutes", (int)BrightTime.Modules.Identity.SignIn.PasswordAccounts.ResetLifetime.TotalMinutes))
    </p>
    <p><a href="/sign-in">@T["account.back_to_sign_in"]</a></p>
}
else
{
    <p>@T["account.forgot.intro"]</p>
    <form method="post" class="editor sign-in" @formname="forgot" @onsubmit="RequestAsync">
        <AntiforgeryToken />
        <div class="field">
            <label for="email">@T["account.field.email"]</label>
            <input id="email" name="email" type="email" autocomplete="username" required />
        </div>
        <div class="actions">
            <button type="submit">@T["account.forgot.submit"]</button>
            <a class="secondary" href="/sign-in">@T["account.back_to_sign_in"]</a>
        </div>
    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "sent")] public string? Sent { get; set; }

    private Task RequestAsync()
    {
        string email = FormValue("email").Trim();
        if (Availability.CanSignIn && email.Length is > 0 and <= 320 && Get<BrightTime.Web.Tenancy.SiteContext>().BaseUrl is { } siteUrl)
        {
            // Queued, not done here: see AccountMailDispatcher. The link is built from the
            // tenant's own address, never the Host header.
            Get<AccountMailDispatcher>().RequestReset(Tenant.TenantId, email, siteUrl, Tenant.Locale);
        }

        Navigation.NavigateTo("/account/forgot?sent=1");
        return Task.CompletedTask;
    }
}
