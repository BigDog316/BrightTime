@page "/sign-in"
@using System.Security.Claims
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Modules.Identity.SignIn
@using BrightTime.SharedKernel.Ids
@using BrightTime.Web.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inherits ConsoleComponent

<PageTitle>Sign in · BrightTime</PageTitle>

<h1>Sign in</h1>

@if (!Availability.CanSignIn)
{
    <p>@(Availability.HasDatabase ? "Signing in is not available on this site yet." : "This site is running on sample data, which has no accounts.")</p>
}
else
{
    @if (User.Identity?.IsAuthenticated == true && !IsPost)
    {
        <p class="notice" role="status">You're signed in as @User.Identity.Name. <a href="/provider">Go to your organisations</a>, or sign in as someone else below.</p>
    }
    @if (ExternalMessage is { } externalMessage)
    {
        <p class="notice error" role="alert">@externalMessage</p>
    }
    @if (Reset == "1")
    {
        <p class="notice success" role="status">Your password has been changed. Sign in with the new one.</p>
    }
    @if (_failed)
    {
        @* One message for every failure, so it never says whether the email is registered (T21). *@
        <p class="notice error" role="alert" id="sign-in-error">
            That email and password don't match an account that can sign in. After five wrong tries an account
            is locked for 15 minutes. You can <a href="/account/forgot">reset your password</a>.
        </p>
    }

    @if (Providers.Count > 0)
    {
        <section aria-labelledby="external-heading" class="external-providers">
            <h2 id="external-heading" class="visually-hidden">Sign in with another account</h2>
            @foreach (var (key, provider) in Providers)
            {
                <form method="post" action="@BrightTime.Web.Auth.ExternalSignIn.StartPath">
                    <AntiforgeryToken />
                    <input type="hidden" name="provider" value="@key" />
                    @if (ReturnUrl is not null)
                    {
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    }
                    <button type="submit" class="secondary-button">Sign in with @provider.DisplayName</button>
                </form>
            }
        </section>
    }

    <section class="needs-webauthn" aria-labelledby="passkey-heading">
        <h2 id="passkey-heading" class="visually-hidden">Sign in with a passkey</h2>
        <p class="notice error" id="passkey-error" role="alert" tabindex="-1" hidden></p>
        <button type="button" data-passkey-action="sign-in" data-return-url="@ReturnUrl">Sign in with a passkey</button>
        <p class="or-divider">Or use your email and password:</p>
    </section>

    <form method="post" class="editor sign-in" @formname="sign-in" @onsubmit="SignInAsync">
        <AntiforgeryToken />
        <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" required value="@_email"
                   aria-describedby="@(_failed ? "sign-in-error" : null)" />
        </div>
        <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <div class="actions">
            <button type="submit">Sign in</button>
            <a class="secondary" href="/account/forgot">Forgot your password?</a>
        </div>
    </form>

    @if (Availability.DevelopmentSignIn)
    {
        <p class="note">Development site: you can also <a href="@DevHref">sign in as a seeded account</a>.</p>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "reset")] public string? Reset { get; set; }

    [SupplyParameterFromQuery(Name = "external")] public string? External { get; set; }

    [SupplyParameterFromQuery(Name = "provider")] public string? ExternalProvider { get; set; }

    [Inject] private Microsoft.Extensions.Options.IOptions<AuthOptions> AuthSettings { get; set; } = default!;

    private IReadOnlyDictionary<string, ExternalProviderOptions> Providers => AuthSettings.Value.External;

    private string? ExternalMessage => External switch
    {
        // Says nothing about whether a BrightTime account exists for that person (D17, T21).
        "unconnected" => $"That {ProviderName} account isn't connected to a BrightTime account here. Sign in another way, then connect it from Sign-in and security.",
        "cancelled" => "Signing in with the other account was cancelled.",
        "failed" => "Signing in with the other account didn't work. Try again, or sign in another way.",
        _ => null,
    };

    private string ProviderName =>
        ExternalProvider is not null && Providers.TryGetValue(ExternalProvider, out ExternalProviderOptions? p) ? p.DisplayName : "external";

    private string? _email;
    private bool _failed;

    private string DevHref => ReturnUrl is null ? "/dev/sign-in" : $"/dev/sign-in?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private async Task SignInAsync()
    {
        if (!Availability.CanSignIn)
        {
            return;
        }

        _email = FormValue("email").Trim();
        string password = FormValue("password");

        UserId? user = await Get<PasswordAccounts>().CheckPasswordAsync(Tenant.TenantId, _email, password, HttpContext.RequestAborted);
        ClaimsPrincipal? principal = user is { } id
            ? await Get<BrightTimePrincipalFactory>().CreateAsync(
                Tenant.TenantId, id, new AuthenticationEvent(AuthenticationMethods.Password, Get<BrightTime.SharedKernel.Time.IClock>().UtcNow), HttpContext.RequestAborted)
            : null;

        if (principal is null)
        {
            _failed = true;
            return;
        }

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
        Navigation.NavigateTo(ConsoleServices.LocalReturnPath(ReturnUrl, principal));
    }
}
