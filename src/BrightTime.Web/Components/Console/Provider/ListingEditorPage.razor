@page "/provider/orgs/{OrgId:guid}/listings/new"
@page "/provider/orgs/{OrgId:guid}/listings/{ListingId:guid}"
@using System.Globalization
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Modules.Opportunities.Contracts
@using BrightTime.Modules.Opportunities.Domain
@using BrightTime.Modules.Opportunities.Editing
@using BrightTime.Modules.Opportunities.Search
@using BrightTime.Modules.Platform.Contracts
@using BrightTime.SharedKernel.Ids
@using BrightTime.SharedKernel.Primitives
@using BrightTime.SharedKernel.Text
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits ConsoleComponent

@if (Forbidden)
{
    <PageTitle>@T["site.denied.title"] · BrightTime</PageTitle>
    <h1>@T["editor.denied"]</h1>
    <p>@T["provider.only_staff"] <a href="/provider">@T["provider.go_to_organisations"]</a></p>
}
else if (_orgName is not null)
{
    <PageTitle>@(ListingId is null ? T["editor.new"] : T.Format("editor.edit_title", ("title", _title ?? ""))) · BrightTime</PageTitle>

    <p class="eyebrow"><a href="/provider/orgs/@OrgId">@_orgName</a></p>
    <h1>@(ListingId is null ? T["editor.new"] : _title)</h1>

    @if (_status is { } status)
    {
        <p class="status-line">
            @T["editor.status"] <strong>@T[ListingLifecycle.StatusPhrase(status)]</strong>
            @if (status == ListingStatus.Published)
            {
                <span> · <a href="/listings/@_slug">@T["editor.view_on_site"]</a></span>
            }
            else
            {
                <span> · <a href="/provider/orgs/@OrgId/listings/@ListingId/preview">@T["editor.preview_link"]</a></span>
            }
            <span> · <a href="/provider/orgs/@OrgId/listings/@ListingId/clone">@T["clone.link"]</a></span>
        </p>
    }

    @if (Saved == "1")
    {
        <p class="notice success" role="status">@T[_status == ListingStatus.Published ? "editor.saved_live" : "editor.saved"]</p>
    }
    @if (Submitted == "1")
    {
        <p class="notice success" role="status">@T["editor.submitted"]</p>
    }
    @if (_problem is not null)
    {
        <p class="notice error" role="alert">@_problem</p>
    }

    @if (_reviewNote is { Length: > 0 } note && _status is ListingStatus.ChangesRequested or ListingStatus.Rejected or ListingStatus.Unpublished)
    {
        <section class="review-note" aria-labelledby="review-note-heading">
            <h2 id="review-note-heading">@T["editor.organiser_note"]</h2>
            <p dir="auto">@note</p>
        </section>
    }

    @if (_status == ListingStatus.PendingReview)
    {
        <p>@T["editor.pending"]</p>
        <form method="post" @formname="withdraw" @onsubmit="WithdrawAsync">
            <AntiforgeryToken />
            <button type="submit" class="secondary-button">@T["editor.withdraw"]</button>
        </form>
    }
    else if (_status is { } s && !ListingEditor.IsEditable(s))
    {
        <p>@T.Format("editor.not_editable", ("status", T[ListingLifecycle.StatusPhrase(s)]))</p>
    }
    else
    {
        @if (_errors.Count > 0)
        {
            <section class="error-summary" aria-labelledby="error-summary-heading" tabindex="-1">
                <h2 id="error-summary-heading">@T["form.check_fields"]</h2>
                <ul>
                    @foreach (var (field, messages) in _errors)
                    {
                        <li><a href="#@field">@T[messages[0]]</a></li>
                    }
                </ul>
            </section>
        }

        <form method="post" class="editor" @formname="listing" @onsubmit="SaveAsync" novalidate>
            <AntiforgeryToken />
            <input type="hidden" name="Version" value="@_form.Version" />

            <nav class="editor-sections" aria-label="@T["editor.sections"]">
                @foreach (string part in Sections)
                {
                    <a href="#@part">@T["editor.section." + part]</a>@(part == Sections[^1] ? "" : " · ")
                }
            </nav>

            <fieldset id="basics">
                <legend>@T["editor.section.basics"]</legend>
                <div class="field">
                    <label for="Kind">@T["finder.field.kind"]</label>
                    <select id="Kind" name="Kind" aria-invalid="@Invalid("Kind")" aria-describedby="@Described("Kind")">
                        @foreach (string value in Kinds)
                        {
                            <option value="@value" selected="@(_form.Kind == value)">@T["listing.kind." + value]</option>
                        }
                    </select>
                    @Error("Kind")
                </div>
                @Field("Title", T["editor.field.title"], _form.Title, hint: T["editor.field.title_hint"], max: ListingFormParser.MaxTitle)
                @Field("Summary", T["editor.field.summary"], _form.Summary, hint: T["editor.field.summary_hint"], max: ListingFormParser.MaxSummary)
                <div class="field">
                    <label for="Description">@T["editor.field.description"]</label>
                    <p class="hint" id="hint-Description">@T["editor.field.description_hint"]</p>
                    <textarea id="Description" name="Description" rows="8" maxlength="@ListingFormParser.MaxDescription"
                              aria-invalid="@Invalid("Description")" aria-describedby="hint-Description @Described("Description")">@_form.Description</textarea>
                    @Error("Description")
                </div>
                <div class="field">
                    <label for="PrimaryLanguage">@T["editor.field.primary_language"]</label>
                    <select id="PrimaryLanguage" name="PrimaryLanguage">
                        @foreach (Locale l in Locale.Supported)
                        {
                            <option value="@l.Code" selected="@(_form.PrimaryLanguage == l.Code)">@l.NativeName (@T["language." + l.Code])</option>
                        }
                    </select>
                    @Error("PrimaryLanguage")
                </div>
            </fieldset>

            <fieldset id="audience">
                <legend>@T["editor.section.audience"]</legend>
                <div class="field-row">
                    @Field("AgeMin", T["editor.field.age_min"], _form.AgeMin, type: "number", width: "short")
                    @Field("AgeMax", T["editor.field.age_max"], _form.AgeMax, type: "number", width: "short")
                </div>
                <div class="field-row">
                    @Field("GradeMin", T["editor.field.grade_min"], _form.GradeMin, hint: T["editor.field.grade_min_hint"], type: "number", width: "short")
                    @Field("GradeMax", T["editor.field.grade_max"], _form.GradeMax, type: "number", width: "short")
                </div>
            </fieldset>

            <fieldset id="topics">
                <legend>@T["editor.section.topics"]</legend>
                <p class="hint">@T["editor.topics_hint"]</p>
                <div id="TermIds">
                    @foreach (VocabularyTerm category in _categories)
                    {
                        <div class="term-group">
                            @Check("TermIds", category.Id.ToString(), category.Name, _form.TermIds.Contains(category.Id), strong: true)
                            <div class="term-children">
                                @foreach (VocabularyTerm interest in _interests.Where(i => i.ParentId == category.Id))
                                {
                                    @Check("TermIds", interest.Id.ToString(), interest.Name, _form.TermIds.Contains(interest.Id))
                                }
                            </div>
                        </div>
                    }
                </div>
                @Error("TermIds")
            </fieldset>

            <fieldset id="where">
                <legend>@T["editor.section.where"]</legend>
                <div id="Modality" class="radio-row">
                    @Radio("Modality", "in_person", T["editor.option.modality.in_person"], _form.Modality)
                    @Radio("Modality", "virtual", T["editor.option.modality.virtual"], _form.Modality)
                    @Radio("Modality", "hybrid", T["editor.option.modality.hybrid"], _form.Modality)
                </div>
                @Error("Modality")
                <div id="SiteIds" class="field">
                    <p class="label">@T["editor.field.sites"]</p>
                    @if (_sites.Count == 0)
                    {
                        <p class="hint">@T["editor.no_sites"]</p>
                    }
                    @foreach (SiteSummary site in _sites)
                    {
                        @Check("SiteIds", site.SiteId.ToString(), site.Name, _form.SiteIds.Contains(site.SiteId))
                    }
                    @Error("SiteIds")
                </div>
                @Field("VirtualUrl", T["editor.field.virtual_url"], _form.VirtualUrl, hint: T["editor.field.virtual_url_hint"], type: "url")
            </fieldset>

            <fieldset id="when">
                <legend>@T["editor.section.when"]</legend>
                <div id="Repeats" class="radio-row">
                    @Radio("Repeats", "weekly", T["editor.option.repeats.weekly"], _form.Repeats)
                    @Radio("Repeats", "once", T["editor.option.repeats.once"], _form.Repeats)
                </div>
                <div id="Days" class="field">
                    <p class="label">@T["editor.field.days"]</p>
                    <div class="radio-row">
                        @foreach (var (code, day) in Days)
                        {
                            @Check("Days", code, T.Culture.DateTimeFormat.GetAbbreviatedDayName(day), _form.Days.Contains(code))
                        }
                    </div>
                    @Error("Days")
                </div>
                <div class="field field-short">
                    <label for="Interval">@T["editor.field.interval"]</label>
                    <select id="Interval" name="Interval" aria-invalid="@Invalid("Interval")" aria-describedby="@Described("Interval")">
                        @for (int n = 1; n <= ListingFormParser.MaxInterval; n++)
                        {
                            string value = n.ToString(CultureInfo.InvariantCulture);
                            <option value="@value" selected="@(_form.Interval == value)">@T.Format("editor.option.interval", ("count", n))</option>
                        }
                    </select>
                    @Error("Interval")
                </div>
                <div class="field-row">
                    @Field("StartsOn", T["editor.field.starts_on"], _form.StartsOn, type: "date")
                    @Field("EndsOn", T["editor.field.ends_on"], _form.EndsOn, hint: T["editor.field.ends_on_hint"], type: "date")
                </div>
                <div class="field-row">
                    @Field("StartTime", T["editor.field.start_time"], _form.StartTime, type: "time")
                    @Field("EndTime", T["editor.field.end_time"], _form.EndTime, type: "time")
                </div>
                <div class="field">
                    <label for="SkipDates">@T["editor.field.skip_dates"]</label>
                    <p class="hint" id="hint-SkipDates">@T["editor.field.skip_dates_hint"]</p>
                    <textarea id="SkipDates" name="SkipDates" rows="3" aria-invalid="@Invalid("SkipDates")"
                              aria-describedby="hint-SkipDates @Described("SkipDates")">@_form.SkipDates</textarea>
                    @Error("SkipDates")
                </div>
                <button type="submit" name="action" value="preview" class="secondary-button">@T["editor.preview_sessions"]</button>
                @if (_preview is { } preview)
                {
                    <div class="preview" role="status">
                        <p>@T.Format("editor.preview_heading", ("count", preview.Count))</p>
                        <ol>
                            @foreach (Occurrence o in preview)
                            {
                                <li>@T.Format("format.date_time", ("date", T.Date(o.StartsAt)), ("time", T.Range(T.Time(o.StartsAt), T.Time(o.EndsAt))))</li>
                            }
                        </ol>
                    </div>
                }
            </fieldset>

            <fieldset id="showing">
                <legend>@T["editor.section.showing"]</legend>
                <p class="hint">@T["editor.showing_hint"]</p>
                <div class="field-row">
                    @Field("ShowFrom", T["editor.field.show_from"], _form.ShowFrom, hint: T["editor.field.show_from_hint"], type: "date")
                    @Field("TakeDownAfter", T["editor.field.take_down_after"], _form.TakeDownAfter, hint: T["editor.field.take_down_after_hint"], type: "date")
                </div>
            </fieldset>

            <fieldset id="cost">
                <legend>@T["editor.section.cost"]</legend>
                <div id="CostModel" class="radio-column">
                    @Radio("CostModel", "free", T["editor.option.cost_model.free"], _form.CostModel)
                    @Radio("CostModel", "fixed", T["editor.option.cost_model.fixed"], _form.CostModel)
                    @Radio("CostModel", "sliding_scale", T["editor.option.cost_model.sliding_scale"], _form.CostModel)
                    @Radio("CostModel", "varies", T["editor.option.cost_model.varies"], _form.CostModel)
                    @Radio("CostModel", "stipend_paid", T["editor.option.cost_model.stipend_paid"], _form.CostModel)
                </div>
                @Error("CostModel")
                <div class="field-row">
                    @Field("CostMin", T["editor.field.cost_min"], _form.CostMin, width: "short")
                    @Field("CostMax", T["editor.field.cost_max"], _form.CostMax, hint: T["editor.field.cost_max_hint"], width: "short")
                </div>
                @Field("SlidingScaleNote", T["editor.field.sliding_scale_note"], _form.SlidingScaleNote, max: ListingFormParser.MaxNote)
            </fieldset>

            <fieldset id="registration">
                <legend>@T["editor.section.registration"]</legend>
                <div id="RegistrationMode" class="radio-column">
                    @Radio("RegistrationMode", "external", T["editor.option.registration_mode.external"], _form.RegistrationMode)
                    @Radio("RegistrationMode", "builtin", T["editor.option.registration_mode.builtin"], _form.RegistrationMode)
                    @Radio("RegistrationMode", "none", T["editor.option.registration_mode.none"], _form.RegistrationMode)
                </div>
                @Error("RegistrationMode")
                @Field("ExternalUrl", T["editor.field.external_url"], _form.ExternalUrl, hint: T["editor.field.external_url_hint"], type: "url")
                @Field("Capacity", T["editor.field.capacity"], _form.Capacity, hint: T["editor.field.capacity_hint"], type: "number", width: "short")
                <div class="field-row">
                    <div class="field">
                        <label for="DeadlineKind">@T["listing.deadline.other"]</label>
                        <select id="DeadlineKind" name="DeadlineKind" aria-invalid="@Invalid("DeadlineKind")">
                            <option value="">@T["editor.option.none"]</option>
                            @foreach (string kind in ListingFormParser.DeadlineKinds)
                            {
                                <option value="@kind" selected="@(_form.DeadlineKind == kind)">@T["listing.deadline." + kind]</option>
                            }
                        </select>
                        @Error("DeadlineKind")
                    </div>
                    @Field("DeadlineOn", T["editor.field.deadline_on"], _form.DeadlineOn, type: "date")
                </div>
            </fieldset>

            <fieldset id="access">
                <legend>@T["editor.section.access"]</legend>
                <div id="AccommodationIds">
                    @foreach (VocabularyTerm a in _accommodations)
                    {
                        @Check("AccommodationIds", a.Id.ToString(), a.Name, _form.AccommodationIds.Contains(a.Id))
                    }
                </div>
                @Error("AccommodationIds")
                @Field("AccessibilityNote", T["editor.field.accessibility_note"], _form.AccessibilityNote, max: ListingFormParser.MaxNote)
                @Check("MealsProvided", "true", T["editor.field.meals_provided"], _form.MealsProvided)
                @Check("TransportProvided", "true", T["editor.field.transport_provided"], _form.TransportProvided)
                @Field("TransportNote", T["editor.field.transport_note"], _form.TransportNote, max: ListingFormParser.MaxNote)
                @Check("IsDropIn", "true", T["editor.field.is_drop_in"], _form.IsDropIn)
                <div id="Languages" class="field">
                    <p class="label">@T["editor.field.languages"]</p>
                    <div class="radio-row">
                        @foreach (Locale l in Locale.Supported)
                        {
                            @Check("Languages", l.Code, l.NativeName, _form.Languages.Contains(l.Code))
                        }
                    </div>
                    @Error("Languages")
                </div>
            </fieldset>

            <fieldset id="contact">
                <legend>@T["editor.section.contact"]</legend>
                @Field("ContactEmail", T["editor.field.contact_email"], _form.ContactEmail, type: "email")
                @Field("ContactPhone", T["editor.field.contact_phone"], _form.ContactPhone, type: "tel", width: "short")
            </fieldset>

            <div class="actions">
                <button type="submit" name="action" value="save">@T[ListingId is null ? "editor.save_draft" : "editor.save_changes"]</button>
                @if (CanSubmit)
                {
                    <button type="submit" name="action" value="submit">@T["editor.save_submit"]</button>
                }
                <a href="/provider/orgs/@OrgId" class="secondary">@T["form.cancel"]</a>
            </div>
        </form>

        @if (_status == ListingStatus.Published)
        {
            <form method="post" class="danger-zone" @formname="unpublish" @onsubmit="UnpublishAsync">
                <AntiforgeryToken />
                <h2>@T["editor.unpublish.heading"]</h2>
                <div class="field">
                    <label for="reason">@T["editor.unpublish.reason"]</label>
                    <textarea id="reason" name="reason" rows="2" aria-invalid="@Invalid("reason")" aria-describedby="@Described("reason")"></textarea>
                    @Error("reason")
                </div>
                <button type="submit" class="secondary-button">@T["editor.unpublish.submit"]</button>
            </form>
        }
    }
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    [Parameter] public Guid? ListingId { get; set; }

    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    [SupplyParameterFromQuery(Name = "submitted")] public string? Submitted { get; set; }

    private static readonly string[] Kinds = ["program", "event", "job", "resource"];

    private static readonly string[] Sections = ["basics", "audience", "topics", "where", "when", "showing", "cost", "registration", "access", "contact"];

    private static readonly (string Code, DayOfWeek Day)[] Days =
    [
        ("MO", DayOfWeek.Monday), ("TU", DayOfWeek.Tuesday), ("WE", DayOfWeek.Wednesday), ("TH", DayOfWeek.Thursday),
        ("FR", DayOfWeek.Friday), ("SA", DayOfWeek.Saturday), ("SU", DayOfWeek.Sunday),
    ];

    private ListingForm _form = new();
    private IReadOnlyDictionary<string, Phrase[]> _errors = new Dictionary<string, Phrase[]>();
    private string? _problem;
    private IReadOnlyList<Occurrence>? _preview;

    private string? _orgName;
    private ListingStatus? _status;
    private string? _title;
    private string? _slug;
    private string? _reviewNote;

    private IReadOnlyList<VocabularyTerm> _categories = [];
    private IReadOnlyList<VocabularyTerm> _interests = [];
    private IReadOnlyList<VocabularyTerm> _accommodations = [];
    private IReadOnlyList<SiteSummary> _sites = [];

    private OrganisationId Org => new(OrgId);

    private bool CanSubmit => _status is null or ListingStatus.Draft or ListingStatus.ChangesRequested or ListingStatus.Unpublished
                              && User.HasPermission(Permissions.Listings.SubmitForReview);

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            Navigation.NotFound();
            return;
        }

        if (!await CanActForAsync(Org, Permissions.Listings.Create))
        {
            Forbid();
            return;
        }

        IDirectoryQueries directory = Get<IDirectoryQueries>();
        _orgName = await directory.GetOrganisationNameAsync(Org);
        if (_orgName is null)
        {
            Navigation.NotFound();
            return;
        }

        if (ListingId is { } id && !await LoadListingAsync(id, keepPostedForm: IsPost))
        {
            return;
        }

        string locale = Tenant.Locale.Code;
        ITaxonomyQueries taxonomy = Get<ITaxonomyQueries>();
        _categories = await taxonomy.GetVocabularyAsync("category", locale);
        _interests = await taxonomy.GetVocabularyAsync("interest", locale);
        _accommodations = await taxonomy.GetVocabularyAsync("accommodation", locale);
        _sites = [.. (await directory.GetOrganisationSitesAsync(Org)).Where(s => s.IsActive)];
    }

    /// <returns>False when the listing is not this organisation's; the page is then a 404.</returns>
    private async Task<bool> LoadListingAsync(Guid id, bool keepPostedForm)
    {
        EditableListing? listing = await Get<ListingEditor>().LoadAsync(id);
        if (listing is null || listing.OrganisationId != Org)
        {
            _orgName = null;
            Navigation.NotFound();
            return false;
        }

        _status = listing.Status;
        _title = listing.Form.Title;
        _slug = listing.Slug;
        _reviewNote = listing.ReviewNote;
        if (!keepPostedForm)
        {
            _form = listing.Form;
        }

        return true;
    }

    private async Task SaveAsync()
    {
        _form = ListingFormBinder.Read(HttpContext.Request.Form);
        string action = FormValue("action");
        ListingEditor editor = Get<ListingEditor>();

        if (action == "preview")
        {
            _preview = editor.PreviewSessions(_form, 8);
            if (_preview is null)
            {
                (_, _errors) = ListingFormParser.Parse(_form);
            }

            return;
        }

        SaveOutcome outcome = await editor.SaveAsync(Org, ListingId, _form, Actor);
        if (!outcome.Saved)
        {
            _errors = outcome.Errors;
            _problem = outcome.Problem is { } problem ? T[problem] : null;
            return;
        }

        Guid id = outcome.ListingId!.Value;
        if (action == "submit" && CanSubmit)
        {
            Result submitted = await editor.TransitionAsync(id, ListingStatus.PendingReview, ListingLifecycle.Mover.Provider, Org, null, Actor);
            if (!submitted.IsSuccess)
            {
                // Saved but not submitted: show the reason against the saved version.
                await LoadListingAsync(id, keepPostedForm: false);
                _problem = T.Format("editor.saved_not_submitted", ("reason", T.Error(submitted.Error!)));
                return;
            }

            Navigation.NavigateTo($"/provider/orgs/{OrgId}/listings/{id}?submitted=1");
            return;
        }

        Navigation.NavigateTo($"/provider/orgs/{OrgId}/listings/{id}?saved=1");
    }

    private async Task WithdrawAsync()
    {
        Result result = await Get<ListingEditor>().TransitionAsync(ListingId!.Value, ListingStatus.Draft, ListingLifecycle.Mover.Provider, Org, null, Actor);
        if (!result.IsSuccess)
        {
            _problem = T.Error(result.Error!);
            return;
        }

        Navigation.NavigateTo($"/provider/orgs/{OrgId}/listings/{ListingId}");
    }

    private async Task UnpublishAsync()
    {
        string reason = FormValue("reason");
        Result result = await Get<ListingEditor>().TransitionAsync(ListingId!.Value, ListingStatus.Unpublished, ListingLifecycle.Mover.Provider, Org, reason, Actor);
        if (!result.IsSuccess)
        {
            _errors = new Dictionary<string, Phrase[]> { ["reason"] = [result.Error!.Phrase] };
            return;
        }

        Navigation.NavigateTo($"/provider/orgs/{OrgId}/listings/{ListingId}");
    }

    private bool HasError(string field) => _errors.ContainsKey(field);

    private string? Invalid(string field) => HasError(field) ? "true" : null;

    private string? Described(string field) => HasError(field) ? $"err-{field}" : null;

    private RenderFragment? Error(string field) => HasError(field)
        ? __builder =>
        {
            <p class="field-error" id="err-@field">@T.Join(_errors[field])</p>
        }
        : null;

    private RenderFragment Field(string name, string label, string value, string? hint = null, string type = "text", int? max = null, string? width = null) => __builder =>
    {
        <div class="field @(width is null ? "" : "field-" + width)">
            <label for="@name">@label</label>
            @if (hint is not null)
            {
                <p class="hint" id="hint-@name">@hint</p>
            }
            <input id="@name" name="@name" type="@type" value="@value" maxlength="@max"
                   aria-invalid="@Invalid(name)" aria-describedby="@Join(hint is null ? null : "hint-" + name, Described(name))" />
            @Error(name)
        </div>
    };

    private static RenderFragment Check(string name, string value, string label, bool isChecked, bool strong = false) => __builder =>
    {
        <label class="check">
            <input type="checkbox" name="@name" value="@value" checked="@isChecked" />
            @if (strong)
            {
                <strong>@label</strong>
            }
            else
            {
                @label
            }
        </label>
    };

    private static RenderFragment Radio(string name, string value, string label, string current) => __builder =>
    {
        <label class="check">
            <input type="radio" name="@name" value="@value" checked="@(current == value)" />
            @label
        </label>
    };

    private static string? Join(string? a, string? b) =>
        (a, b) switch
        {
            (null, null) => null,
            (null, _) => b,
            (_, null) => a,
            _ => $"{a} {b}",
        };

}
