<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere, except the emulator's view of the developer's machine (10.0.2.2), where the
  local stack (deploy/compose.yml) serves plain HTTP. A release build's region is https only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
