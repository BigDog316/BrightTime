@page "/messages/{Id:guid}"
@* One conversation (D53, D75): who is in it, always, and its messages; a reply unless it's an
   announcement (D54). Staff are named by their organisation only. Opening it marks it read. The
   push for a new message links here (notify.message.new). *@
@inject BrightTimeApi Api
@inject AppSession Session

@if (!Session.IsSignedIn)
{
    <h1>@T["app.messages.title"]</h1>
    <a class="button primary" href="sign-in">@T["account.sign_in.title"]</a>
}
else if (_conversation is not { } c)
{
    <h1>@T["app.messages.title"]</h1>
    <ProblemNotice Problem="_problem" Retry="LoadAsync" />
    @if (_problem is null)
    {
        <Busy />
    }
}
else
{
    <h1 dir="auto">@(c.Subject ?? T["app.messages.no_subject"])</h1>
    <p>@T.Format(c.IsAnnouncement ? "app.messages.announcement_from" : "app.messages.from", ("org", Text.Name(c.OrgName)))</p>

    <section aria-labelledby="who">
        <h2 id="who">@T["app.messages.who"]</h2>
        <ul>
            <li>@T["app.messages.who.you"]</li>
            @foreach (string role in OrgRoles.Where(c.Roles.Contains))
            {
                <li>@T.Format("app.messages.who." + role, ("org", Text.Name(c.OrgName)))</li>
            }
        </ul>
        @if (c.IsAnnouncement)
        {
            <p class="hint">@T["app.messages.announcement_hint"]</p>
        }
        @if (c.ReadByOrganisation)
        {
            <p class="notice">@T.Format("app.messages.read_by_org", ("org", Text.Name(c.OrgName)))</p>
        }
    </section>

    <ProblemNotice Problem="_problem" Retry="LoadAsync" />
    <ol class="messages">
        @foreach (ConversationMessage m in c.Messages)
        {
            <li class="@(m.FromMe ? "mine" : null)" @key="m.Id">
                <p class="hint">
                    @Sender(c, m) · @T.DayTime(m.SentAt)
                    @if (m.IsHeld)
                    {
                        <strong>@(" · " + T["app.messages.held"])</strong>
                    }
                    else if (m.IsRemoved)
                    {
                        <strong>@(" · " + T["app.messages.removed"])</strong>
                    }
                </p>
                <p class="body" dir="auto">@m.Body</p>
                @if (m.FromMe && m.IsHeld && HeldFor(m) is { } why)
                {
                    <p class="hint">@why</p>
                }
                @if (!m.FromMe && !m.IsHeld && !m.IsRemoved)
                {
                    @if (_reported.Contains(m.Id))
                    {
                        <p class="hint">@T["app.messages.report.reported"]</p>
                    }
                    else if (_reporting == m.Id)
                    {
                        @ReportForm(c, m)
                    }
                    else
                    {
                        <button type="button" @onclick="() => StartReport(m.Id)"
                                aria-label="@T.Format("app.messages.report.label", ("sender", Sender(c, m)), ("time", T.DayTime(m.SentAt)))">@T["app.messages.report"]</button>
                    }
                }
            </li>
        }
    </ol>
    @if (_reportNote is not null)
    {
        <p class="notice" role="status">@_reportNote</p>
    }

    @* An announcement takes no reply: the hint above already says so. *@
    @if (!c.IsAnnouncement)
    {
        <div class="field">
            <label for="reply">@T["app.messages.reply"]</label>
            <textarea id="reply" rows="4" maxlength="@MaxBody" dir="auto" @bind="_draft" @bind:event="oninput"></textarea>
        </div>
        @* Beside the button: on a long thread the top of the page is off screen. *@
        <ProblemNotice Problem="_sendProblem" />
        @if (_sendNote is not null)
        {
            <p class="notice" role="status">@_sendNote</p>
        }
        <div class="actions">
            <button type="button" class="primary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft))">@T["app.messages.send"]</button>
        </div>
    }

    <div class="actions">
        <button type="button" @onclick="LoadAsync" disabled="@_busy">@T["app.messages.check"]</button>
        <a class="button" href="messages">@T["app.messages.back"]</a>
    </div>
}

@code {
    /// <summary>The organisation's people a family is shown, in this order: who writes, then who reads along.</summary>
    private static readonly string[] OrgRoles = ["staff", "mentor", "org_admin_observer"];

    /// <summary>The server's limit (Conversations.MaxBody).</summary>
    private const int MaxBody = 8000;

    [Parameter] public Guid Id { get; set; }

    private Conversation? _conversation;
    private ApiProblem? _problem;
    private ApiProblem? _sendProblem;
    private string? _sendNote;
    private string _draft = string.Empty;
    private bool _busy;

    // Reporting a message (D115): one form open at a time; what was reported this visit.
    private static readonly string[] ReportReasons =
        ["grooming_concern", "self_harm", "sexual_content", "violence", "harassment", "hate_speech", "personal_information", "spam", "safety_other"];

    /// <summary>The server's limit (Reports.MaxDetails).</summary>
    private const int MaxDetails = 2000;

    private Guid? _reporting;
    private string? _reportReason;
    private string _reportDetails = string.Empty;
    private ApiProblem? _reportProblem;
    private string? _reportNote;
    private readonly HashSet<Guid> _reported = [];

    protected override Task OnParametersSetAsync() => Session.IsSignedIn ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        _problem = null;
        _sendProblem = null;
        _sendNote = null;
        ApiResult<Conversation> found = await Api.ConversationAsync(Id);
        _problem = found.Problem;
        _conversation = found.Value ?? _conversation;
    }

    private async Task SendAsync()
    {
        if (_conversation is not { } c || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        _busy = true;
        _sendProblem = null;
        _sendNote = null;
        try
        {
            ApiResult<ConversationMessage> sent = await Api.SendMessageAsync(c.Id, _draft);
            if (sent.Value is not { } message)
            {
                _sendProblem = sent.Problem;
                return;
            }

            _conversation = c with { Messages = [.. c.Messages, message] };
            _draft = string.Empty;
            _sendNote = message.IsHeld ? HeldFor(message) ?? T["app.messages.sent_held"] : T["app.messages.sent"];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Why one of the person's own messages is held, in words, so they can rewrite it (D117).</summary>
    private string? HeldFor(ConversationMessage m) =>
        m.HeldFor is { Count: > 0 } reasons
            ? T.Format("app.messages.held_for", ("what", string.Join(", ", reasons.Select(r => T.Has("app.messages.held_reason." + r) ? T["app.messages.held_reason." + r] : r))))
            : null;

    private void StartReport(Guid message)
    {
        _reporting = message;
        _reportReason = null;
        _reportDetails = string.Empty;
        _reportProblem = null;
        _reportNote = null;
    }

    private async Task SendReportAsync(Guid message)
    {
        if (_reportReason is not { } reason)
        {
            return;
        }

        _busy = true;
        _reportProblem = null;
        try
        {
            ApiResult<ReportReceipt> made = await Api.ReportMessageAsync(message, reason, string.IsNullOrWhiteSpace(_reportDetails) ? null : _reportDetails);
            if (made.Value is not { } receipt)
            {
                _reportProblem = made.Problem;
                return;
            }

            _reported.Add(message);
            _reporting = null;
            _reportNote = T[receipt.IsCritical ? "app.messages.report.done_critical" : "app.messages.report.done"];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>What's wrong, in the reporter's words if they like; who to call if someone is in danger now.</summary>
    private RenderFragment ReportForm(Conversation c, ConversationMessage m) => __builder =>
    {
        string id = m.Id.ToString("N");
        <div class="report-form">
            <fieldset>
                <legend>@T["app.messages.report.why"]</legend>
                @foreach (string reason in ReportReasons)
                {
                    <label class="check">
                        <input type="radio" name="report-@id" value="@reason" checked="@(_reportReason == reason)" @onchange="() => _reportReason = reason" />
                        @T["app.messages.report.reason." + reason]
                    </label>
                }
            </fieldset>
            <p class="notice">@T["app.messages.report.danger"]</p>
            <div class="field">
                <label for="report-details-@id">@T["app.messages.report.details"]</label>
                <textarea id="report-details-@id" rows="3" maxlength="@MaxDetails" dir="auto" @bind="_reportDetails" @bind:event="oninput"></textarea>
            </div>
            <ProblemNotice Problem="_reportProblem" />
            <div class="actions">
                <button type="button" class="primary" @onclick="() => SendReportAsync(m.Id)" disabled="@(_busy || _reportReason is null)">@T["app.messages.report.send"]</button>
                <button type="button" @onclick="() => _reporting = null">@T["app.messages.report.cancel"]</button>
            </div>
        </div>
    };

    /// <summary>Who wrote it: the person themself, or the organisation's staff, never by name.</summary>
    private string Sender(Conversation c, ConversationMessage m) =>
        m.FromMe ? T["app.messages.me"]
        : T.Has("app.messages.sender." + m.SenderRole) ? T.Format("app.messages.sender." + m.SenderRole, ("org", Text.Name(c.OrgName)))
        : T["app.messages.sender.other"];
}
