@using System.Globalization
@using BrightTime.Infrastructure.Tenancy
@using BrightTime.Modules.Opportunities.Contracts
@using BrightTime.SharedKernel.Primitives
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Web.Finder
@inject ITenantContext Tenant

@* The listing as a family sees it. The public page and the organiser's preview both render
   this, so what is approved is exactly what is published. *@
<article class="listing-detail" aria-labelledby="listing-title">
    <header>
        <p class="eyebrow">@T["listing.kind." + l.Kind.ToDbValue()]</p>
        <h1 id="listing-title" dir="auto" lang="@LangAttr(l.ContentLanguage)">@l.Title</h1>
        @if (OrganisationSlug is { } orgSlug)
        {
            <p class="byline">@T["listing.byline_before"] <a href="/organisations/@Uri.EscapeDataString(orgSlug)"><bdi>@l.OrganisationName</bdi></a></p>
        }
        else
        {
            <p class="byline">@T.Format("listing.byline", ("organisation", Org))</p>
        }
        <p class="lead" dir="auto" lang="@LangAttr(l.ContentLanguage)">@l.Summary</p>
        @if (l.IsMachineTranslated)
        {
            <p class="note">@T.Format("listing.machine_translated", ("language", LanguageInPage(l.PrimaryLanguage)))</p>
        }
        @if (ShowPublicLinks && HttpContext is not null)
        {
            @* A plain form: saving works without JavaScript, and the list stays on this device (D22). *@
            <form method="post" action="@SavedListings.ChangePath" class="save-form">
                <AntiforgeryToken />
                <input type="hidden" name="listing" value="@l.Id.Value" />
                <input type="hidden" name="action" value="@(IsSaved ? "remove" : "save")" />
                <input type="hidden" name="returnUrl" value="@ReturnPath" />
                <button type="submit" class="secondary-button" aria-pressed="@(IsSaved ? "true" : "false")">@T[IsSaved ? "saved.saved" : "saved.save"]</button>
                @if (IsSaved)
                {
                    <a href="/saved">@T["saved.see_all"]</a>
                }
            </form>
        }
    </header>

    <section aria-labelledby="glance-heading">
        <h2 id="glance-heading">@T["listing.glance"]</h2>
        <dl class="facts">
            @if (AgeLabel(l) is { } ages)
            {
                <dt>@T["listing.fact.ages"]</dt>
                <dd>@ages</dd>
            }
            @if (GradeLabel(l) is { } grades)
            {
                <dt>@T["listing.fact.grades"]</dt>
                <dd>@grades</dd>
            }
            <dt>@T["listing.fact.price"]</dt>
            <dd>
                @PriceLabel(l)
                @if (l.SlidingScaleNote is { Length: > 0 } note)
                {
                    <span class="note" dir="auto">@note</span>
                }
            </dd>
            <dt>@T["listing.fact.where"]</dt>
            <dd>@T["listing.modality." + l.Modality.ToDbValue()]</dd>
            @if (l.Languages.Count > 0)
            {
                <dt>@T["listing.fact.languages"]</dt>
                <dd>
                    @for (int i = 0; i < l.Languages.Count; i++)
                    {
                        @* Each language in its own name and script, as a speaker looks for it. *@
                        <span lang="@l.Languages[i]" dir="auto">@LanguageName(l.Languages[i])</span>@(i < l.Languages.Count - 1 ? T["format.list_separator"] : "")
                    }
                </dd>
            }
            @if (l.Categories.Count > 0)
            {
                <dt>@T["listing.fact.topics"]</dt>
                <dd>@string.Join(T["format.list_separator"], l.Categories)</dd>
            }
            @if (l.MealsProvided)
            {
                <dt>@T["listing.fact.food"]</dt>
                <dd>@T["listing.meals_provided"]</dd>
            }
            @if (l.TransportProvided || l.TransportNote is { Length: > 0 })
            {
                <dt>@T["listing.fact.getting_there"]</dt>
                @if (l.TransportNote is { Length: > 0 } transport)
                {
                    <dd dir="auto">@transport</dd>
                }
                else
                {
                    <dd>@T["listing.transport_provided"]</dd>
                }
            }
        </dl>
    </section>

    <section aria-labelledby="register-heading" class="register">
        <h2 id="register-heading">@T[IsJob ? "listing.register.heading_apply" : "listing.register.heading_join"]</h2>
        @switch (l.RegistrationMode)
        {
            case RegistrationMode.External when SafeLink(l.ExternalUrl) is { } url:
                @* No target="_blank": the visitor decides whether to open a new tab. *@
                <p>
                    <a class="button" href="@url" rel="external noopener noreferrer">
                        @T[IsJob ? "listing.register.apply" : "listing.register.register"]<span class="visually-hidden"> @T["listing.register.opens_provider_site"]</span>
                    </a>
                </p>
                <p class="note">@T.Format("listing.register.on_provider_site", ("organisation", Org))</p>
                break;

            case RegistrationMode.External:
                <p>@T.Format(IsJob ? "listing.register.contact_to_apply" : "listing.register.contact_to_register", ("organisation", Org))</p>
                break;

            case RegistrationMode.Builtin:
            case RegistrationMode.WaitlistOnly:
                @* Built-in registration is a later milestone; say so rather than show a dead button. *@
                <p>@T.Format("listing.register.builtin_soon", ("organisation", Org))</p>
                break;

            default:
                <p>@T["listing.register.none"]@(l.IsDropIn ? " " + T["listing.register.just_come"] : "")</p>
                break;
        }

        @if (l.Deadlines.Count > 0)
        {
            <h3>@T["listing.deadlines"]</h3>
            <ul class="deadlines">
                @foreach (ListingDeadlineView d in l.Deadlines)
                {
                    <li>
                        <strong dir="auto">@(d.Label ?? DeadlineLabel(d.Kind))</strong>:
                        <time datetime="@d.DueAt.ToString("O", CultureInfo.InvariantCulture)">@T.Date(d.DueAt)</time>
                    </li>
                }
            </ul>
        }

        @if (l.ContactEmail is { Length: > 0 } || l.ContactPhone is { Length: > 0 })
        {
            <h3>@T["listing.questions"]</h3>
            <ul class="contact">
                @if (l.ContactEmail is { Length: > 0 } email)
                {
                    <li><a href="mailto:@email" dir="ltr">@email</a></li>
                }
                @if (l.ContactPhone is { Length: > 0 } phone)
                {
                    @* Telephone numbers read left to right in every script. *@
                    <li><a href="tel:@PhoneHref(phone)" dir="ltr">@phone</a></li>
                }
            </ul>
        }
    </section>

    <section aria-labelledby="schedule-heading">
        <h2 id="schedule-heading">@T["listing.sessions"]</h2>
        @if (l.Upcoming.Count == 0)
        {
            <p>@T.Format("listing.sessions.none", ("organisation", Org))</p>
        }
        else
        {
            <ol class="sessions">
                @foreach (ListingTime t in l.Upcoming)
                {
                    <li>
                        <time datetime="@t.StartsAt.ToString("O", CultureInfo.InvariantCulture)">@LocalRange(t)</time>
                    </li>
                }
            </ol>
            <p class="note">@T["listing.sessions.local_time"]</p>
            @if (ShowPublicLinks)
            {
                <p><a class="calendar-link" href="@CalendarHref" download>@T["listing.sessions.calendar"]</a></p>
            }
        }
    </section>

    @if (l.Places.Count > 0)
    {
        <section aria-labelledby="places-heading">
            <h2 id="places-heading">@T.Format("listing.places", ("count", l.Places.Count))</h2>
            <ul class="places">
                @foreach (ListingPlace p in l.Places)
                {
                    <li>
                        <p class="place-name" dir="auto">@p.Name</p>
                        @if (HoodCode(p) is { } hoodCode && p.NeighbourhoodName is { } hoodName)
                        {
                            <p class="note"><a href="/neighbourhoods/@hoodCode">@T.Format("org.more_in_area", ("area", BrightTime.Localisation.Text.Name(hoodName)))</a></p>
                        }
                        @if (p.IsAddressPublic)
                        {
                            <address dir="auto">
                                @foreach (string line in AddressLines(p))
                                {
                                    @line<br />
                                }
                            </address>
                        }
                        else
                        {
                            <p>
                                @if (p.NeighbourhoodName is { } hood)
                                {
                                    @T.Format("listing.places.area", ("area", BrightTime.Localisation.Text.Name(hood)))
                                    @(" ")
                                }
                                @T["listing.places.address_after_registering"]
                            </p>
                        }
                        @if (p.TransitNote is { Length: > 0 } transit)
                        {
                            <p class="note" dir="auto">@transit</p>
                        }
                        @if (p.IsWheelchairAccessible == true)
                        {
                            <p class="note">@T["listing.places.wheelchair"]</p>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (l.Accommodations.Count > 0 || l.AccessibilityNote is { Length: > 0 })
    {
        <section aria-labelledby="access-heading">
            <h2 id="access-heading">@T["listing.access"]</h2>
            @if (l.Accommodations.Count > 0)
            {
                <ul>
                    @foreach (string a in l.Accommodations)
                    {
                        <li>@a</li>
                    }
                </ul>
            }
            @if (l.AccessibilityNote is { Length: > 0 } access)
            {
                <p dir="auto">@access</p>
            }
        </section>
    }

    @if (l.Description is { Length: > 0 } description)
    {
        <section aria-labelledby="about-heading">
            <h2 id="about-heading">@T["listing.about"]</h2>
            @* Plain text from the provider, split into paragraphs and encoded. Never markup.
               dir="auto": the provider may write in a different language from the page's. *@
            @foreach (string paragraph in Paragraphs(description))
            {
                <p dir="auto" lang="@LangAttr(l.DescriptionLanguage)">@paragraph</p>
            }
        </section>
    }

    @if (ShowPublicLinks)
    {
        <p class="back"><a href="@SearchHref">@T["listing.back_to_search"]</a></p>
    }
</article>

@code {
    /// <summary>The listing, as a family sees it.</summary>
    [Parameter, EditorRequired] public ListingDetail Listing { get; set; } = default!;

    /// <summary>The ?lang= the page was asked for, carried onto its links.</summary>
    [Parameter] public string? Lang { get; set; }

    /// <summary>False for a preview: no calendar file or search link for a listing that is not public.</summary>
    [Parameter] public bool ShowPublicLinks { get; set; } = true;

    /// <summary>The organisation's page, when it has one (approved organisations only).</summary>
    [Parameter] public string? OrganisationSlug { get; set; }

    /// <summary>Neighbourhood codes by id, for linking a place to its neighbourhood's page.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, string>? NeighbourhoodCodes { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool IsSaved => HttpContext is not null && SavedListings.Contains(HttpContext.Request, Listing.Id.Value);

    private string ReturnPath => HttpContext is { } http ? http.Request.Path + http.Request.QueryString : "/saved";

    private string? HoodCode(ListingPlace p) =>
        p.NeighbourhoodId is { } id && NeighbourhoodCodes?.TryGetValue(id, out string? code) == true ? code : null;

    // Short, because the markup reads it on almost every line.
    private ListingDetail l => Listing;

    private bool IsJob => l.Kind == ListingKind.Job;

    /// <summary>The organisation's name, isolated for use inside a sentence.</summary>
    private string Org => BrightTime.Localisation.Text.Name(l.OrganisationName);

    /// <summary>
    /// A lang attribute only where the content's language differs from the page's, so screen
    /// readers switch voice for it and browsers pick the right fonts and hyphenation.
    /// </summary>
    private string? LangAttr(string language) =>
        string.Equals(language, Tenant.Locale.Code, StringComparison.OrdinalIgnoreCase) ? null : language;

    private string LangSuffix => Lang is null ? "" : $"?lang={Uri.EscapeDataString(Lang)}";

    private string SearchHref => "/search" + LangSuffix;

    private string CalendarHref => $"/listings/{Uri.EscapeDataString(Listing.Slug)}/calendar.ics";

    private string LocalRange(ListingTime t)
    {
        DateTimeOffset start = TimeZoneInfo.ConvertTime(t.StartsAt, Tenant.TimeZone);
        DateTimeOffset end = TimeZoneInfo.ConvertTime(t.EndsAt, Tenant.TimeZone);
        return start.Date == end.Date
            ? T.Format("format.date_time", ("date", T.DayLong(t.StartsAt)), ("time", T.Range(T.Time(t.StartsAt), T.Time(t.EndsAt))))
            : T.Range(
                T.Format("format.date_time", ("date", T.DayLong(t.StartsAt)), ("time", T.Time(t.StartsAt))),
                T.Format("format.date_time", ("date", T.DayLong(t.EndsAt)), ("time", T.Time(t.EndsAt))));
    }

    private string PriceLabel(ListingDetail l) => l.CostModel switch
    {
        CostModel.Free => T["listing.price.free"],
        CostModel.Fixed when l.CostCentsMin is { } c => T.Money(c),
        CostModel.SlidingScale when l.CostCentsMin is { } min && l.CostCentsMax is { } max =>
            T.Format("listing.price.sliding", ("min", T.Money(min)), ("max", T.Money(max))),
        CostModel.StipendPaid => T["listing.price.paid"],
        _ => T["listing.price.varies"],
    };

    private string? AgeLabel(ListingDetail l) => (l.AgeMin, l.AgeMax) switch
    {
        ({ } min, { } max) => T.Format("listing.ages.range", ("min", min), ("max", max)),
        ({ } min, null) => T.Format("listing.ages.from", ("min", min)),
        (null, { } max) => T.Format("listing.ages.up_to", ("max", max)),
        _ => null,
    };

    private string? GradeLabel(ListingDetail l) => (l.GradeMin, l.GradeMax) switch
    {
        ({ } min, { } max) => T.Format("listing.grades.range", ("min", Grade(min)), ("max", Grade(max))),
        ({ } min, null) => T.Format("listing.grades.from", ("min", Grade(min))),
        (null, { } max) => T.Format("listing.grades.up_to", ("max", Grade(max))),
        _ => null,
    };

    /// <summary>The schema stores pre-K as -1 and kindergarten as 0.</summary>
    private string Grade(int grade) => grade switch
    {
        -1 => T["listing.grade.pre_k"],
        0 => T["listing.grade.kindergarten"],
        _ => T.Format("listing.grade.number", ("grade", grade)),
    };

    /// <summary>The kinds in <c>ck_listing_deadline_kind</c>; the provider's own label wins when set.</summary>
    private string DeadlineLabel(string kind) => T.Has("listing.deadline." + kind) ? T["listing.deadline." + kind] : T["listing.deadline.other"];

    /// <summary>A language named in the page's own language: "translated from Spanish" in an English page.</summary>
    private string LanguageInPage(string code) => T.Has("language." + code) ? T["language." + code] : LanguageName(code);

    /// <summary>The language's own name for itself, which is how a speaker looks for it.</summary>
    private static string LanguageName(string code)
    {
        if (Locale.TryFromCode(code, out Locale supported))
        {
            return supported.NativeName;
        }

        try
        {
            return CultureInfo.GetCultureInfo(code).NativeName;
        }
        catch (CultureNotFoundException)
        {
            return code;
        }
    }

    private static IEnumerable<string> AddressLines(ListingPlace p) =>
        new[] { p.AddressLine1, p.AddressLine2, string.Join(" ", new[] { p.Locality, p.PostalCode }.Where(x => !string.IsNullOrWhiteSpace(x))) }
            .Where(x => !string.IsNullOrWhiteSpace(x))!;

    private static IEnumerable<string> Paragraphs(string text) =>
        text.Replace("\r\n", "\n", StringComparison.Ordinal)
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>
    /// The database only accepts http(s) here; this check is so that a bad row from an
    /// import or a future code path still cannot put a <c>javascript:</c> URL in a link.
    /// </summary>
    private static string? SafeLink(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out Uri? uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
            ? uri.AbsoluteUri
            : null;

    private static string PhoneHref(string phone) =>
        new(phone.Where(c => char.IsAsciiDigit(c) || c == '+').ToArray());
}
