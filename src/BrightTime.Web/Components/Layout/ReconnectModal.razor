<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">@T["site.reconnect.rejoining"]</p>
        <p class="components-reconnect-repeated-attempt-visible">
            @* The script fills in the seconds; the sentence around it is the translator's. *@
            @T["site.reconnect.retrying_before"] <span id="components-seconds-to-next-attempt"></span> @T["site.reconnect.retrying_after"]
        </p>
        <p class="components-reconnect-failed-visible">@T["site.reconnect.failed"]</p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">@T["site.reconnect.retry"]</button>
        <p class="components-pause-visible">@T["site.reconnect.paused"]</p>
        <p class="components-resume-failed-visible">@T["site.reconnect.resume_failed"]</p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">@T["site.reconnect.resume"]</button>
    </div>
</dialog>
