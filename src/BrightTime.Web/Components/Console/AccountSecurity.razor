@page "/account/security"
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Infrastructure.Auditing
@using BrightTime.Modules.Identity.SignIn
@using BrightTime.SharedKernel.Ids
@using Microsoft.AspNetCore.Authorization
@* Changing how the account signs in is a step-up action (T21): the page itself needs a recent confirmation. *@
@attribute [Authorize(Policy = BrightTime.Web.Auth.StepUp.Policy)]
@inherits ConsoleComponent

<PageTitle>@T["account.security.title"] · BrightTime</PageTitle>

<h1>@T["account.security.title"]</h1>

@if (!Availability.CanSignIn)
{
    <p>@T["account.unavailable"]</p>
}
else
{
    @if (Added == "1")
    {
        <p class="notice success" role="status">@T["account.passkey.added"]</p>
    }
    @if (_message is not null)
    {
        <p class="notice" role="status">@_message</p>
    }

    <section aria-labelledby="passkeys-heading">
        <h2 id="passkeys-heading">@T["account.passkey.heading"]</h2>
        <p>@T["account.passkey.explain"]</p>

        @if (_passkeys.Count == 0)
        {
            <p>@T["account.passkey.none"]</p>
        }
        else
        {
            <ul class="passkey-list">
                @foreach (PasskeySummary p in _passkeys)
                {
                    <li>
                        <span>
                            <strong>@p.Name</strong>
                            <span class="note">
                                @T.Format("account.passkey.added_on", ("date", T.DateShort(p.CreatedAt)))
                                · @(p.LastUsedAt is { } used ? T.Format("account.passkey.last_used", ("date", T.DateShort(used))) : T["account.passkey.not_used"])
                                @if (p.IsBackedUp)
                                {
                                    <text> · @T["account.passkey.synced"]</text>
                                }
                            </span>
                        </span>
                        <form method="post" @formname="@($"revoke-{p.Id:N}")" @onsubmit="() => RevokeAsync(p.Id)">
                            <AntiforgeryToken />
                            <button type="submit" class="secondary-button">@T["account.passkey.remove"]<span class="visually-hidden"> @p.Name</span></button>
                        </form>
                    </li>
                }
            </ul>
        }

        <div class="needs-webauthn">
            <div class="editor sign-in">
                <div class="field">
                    <label for="passkey-name">@T["account.passkey.name_label"]</label>
                    <p class="hint" id="passkey-name-hint">@T["account.passkey.name_hint"]</p>
                    <input id="passkey-name" type="text" maxlength="@Passkeys.MaxNameLength" aria-describedby="passkey-name-hint" />
                </div>
            </div>
            <p class="notice error" id="passkey-error" role="alert" tabindex="-1" hidden></p>
            @* The script reads the antiforgery token from the page. *@
            <AntiforgeryToken />
            <button type="button" data-passkey-action="register">@T["account.passkey.add"]</button>
        </div>
        <noscript><p class="note">@T["account.passkey.needs_script"]</p></noscript>
    </section>

    @if (Providers.Count > 0)
    {
        <section aria-labelledby="external-heading">
            <h2 id="external-heading">@T["account.external.heading"]</h2>
            <p>@T["account.external.explain"]</p>
            @if (ExternalMessage is { } externalMessage)
            {
                <p class="notice" role="status">@externalMessage</p>
            }
            <ul class="passkey-list">
                @foreach (var (key, provider) in Providers)
                {
                    ExternalLoginSummary? connected = _external.FirstOrDefault(e => e.DisplayName == provider.DisplayName);
                    <li>
                        <span>
                            <strong>@provider.DisplayName</strong>
                            <span class="note">@(connected is null ? T["account.external.not_connected"] : T.Format("account.external.connected_on", ("date", T.DateShort(connected.LinkedAt))))</span>
                        </span>
                        @if (connected is null)
                        {
                            <form method="post" action="@BrightTime.Web.Auth.ExternalSignIn.LinkPath">
                                <AntiforgeryToken />
                                <input type="hidden" name="provider" value="@key" />
                                <button type="submit" class="secondary-button">@T["account.external.connect"]<span class="visually-hidden"> @provider.DisplayName</span></button>
                            </form>
                        }
                        else
                        {
                            <form method="post" @formname="@($"disconnect-{key}")" @onsubmit="() => DisconnectAsync(connected.Issuer)">
                                <AntiforgeryToken />
                                <button type="submit" class="secondary-button">@T["account.external.disconnect"]<span class="visually-hidden"> @provider.DisplayName</span></button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    <section aria-labelledby="password-heading">
        <h2 id="password-heading">@T["account.field.password"]</h2>
        <p>@T["account.security.password"] <a href="/account/forgot">@T["account.security.password_link"]</a></p>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "added")] public string? Added { get; set; }

    [SupplyParameterFromQuery(Name = "external")] public string? External { get; set; }

    [Inject] private Microsoft.Extensions.Options.IOptions<BrightTime.Web.Auth.AuthOptions> AuthSettings { get; set; } = default!;

    private IReadOnlyDictionary<string, BrightTime.Web.Auth.ExternalProviderOptions> Providers => AuthSettings.Value.External;

    private IReadOnlyList<ExternalLoginSummary> _external = [];

    private string? ExternalMessage => External switch
    {
        "connected" => T["account.external.done"],
        "already" => T["account.external.already"],
        "in_use" => T["account.external.in_use"],
        "wrong_session" => T["account.external.wrong_session"],
        _ => null,
    };

    private async Task DisconnectAsync(string issuer)
    {
        bool removed = await Get<ExternalLogins>().UnlinkAsync(Tenant.TenantId, Actor, issuer);
        if (removed)
        {
            Get<AuditTrail>().Record(AuthAudit.Allowed(AuthAudit.ExternalDisconnected, Actor, detail: new Dictionary<string, string> { ["issuer"] = issuer }));
        }

        _message = T[removed ? "account.external.disconnected" : "account.external.already_disconnected"];
        _external = await Get<ExternalLogins>().ListAsync(Tenant.TenantId, Actor);
    }

    private IReadOnlyList<PasskeySummary> _passkeys = [];
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        if (Availability.CanSignIn)
        {
            _passkeys = await Get<Passkeys>().ListAsync(Tenant.TenantId, Actor);
            _external = await Get<ExternalLogins>().ListAsync(Tenant.TenantId, Actor);
        }
    }

    private async Task RevokeAsync(Guid id)
    {
        bool removed = await Get<Passkeys>().RevokeAsync(Tenant.TenantId, Actor, id);
        if (removed)
        {
            Get<AuditTrail>().Record(AuthAudit.Allowed(AuthAudit.PasskeyRemoved, Actor, detail: new Dictionary<string, string> { ["passkey"] = id.ToString("N") }));
        }

        _message = T[removed ? "account.passkey.removed" : "account.passkey.already_removed"];
        _passkeys = await Get<Passkeys>().ListAsync(Tenant.TenantId, Actor);
    }
}
