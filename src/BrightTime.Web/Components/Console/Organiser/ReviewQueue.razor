@page "/organiser/review"
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Directory.Review
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Modules.Opportunities.Editing
@using BrightTime.Web.Auth
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = ConsoleServices.ReviewPolicy)]
@inherits ConsoleComponent

<PageTitle>@T["site.nav.review"] · BrightTime</PageTitle>

<h1>@T["site.nav.review"]</h1>

@if (Done is { Length: > 0 })
{
    <p class="notice success" role="status">@T[T.Has("organiser.done." + Done) ? "organiser.done." + Done : "organiser.done.other"]</p>
}

@if (!Availability.IsAvailable)
{
    <p>@T["organiser.no_database"]</p>
}
else
{
    <section aria-labelledby="listings-heading">
        <h2 id="listings-heading">@T["organiser.queue.waiting"] <span class="count">(@_listings.AwaitingReview.Count)</span></h2>
        @if (_listings.AwaitingReview.Count == 0)
        {
            <p>@T["organiser.queue.nothing"]</p>
        }
        else
        {
            <table class="queue">
                <caption class="visually-hidden">@T["organiser.queue.oldest_first"]</caption>
                <thead><tr><th scope="col">@T["organiser.col.listing"]</th><th scope="col">@T["organiser.col.organisation"]</th><th scope="col">@T["organiser.col.submitted"]</th></tr></thead>
                <tbody>
                    @foreach (ListingRow row in _listings.AwaitingReview)
                    {
                        <tr>
                            <td><a href="/organiser/review/listings/@row.Id">@row.Title</a></td>
                            <td>@OrgName(row)</td>
                            <td>@When(row.SubmittedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section aria-labelledby="changed-heading">
        <h2 id="changed-heading">@T["organiser.queue.changed"] <span class="count">(@_listings.ChangedSinceReview.Count)</span></h2>
        <p class="hint">@T["organiser.queue.changed_hint"]</p>
        @if (_listings.ChangedSinceReview.Count == 0)
        {
            <p>@T["organiser.queue.nothing_changed"]</p>
        }
        else
        {
            <table class="queue">
                <thead><tr><th scope="col">@T["organiser.col.listing"]</th><th scope="col">@T["organiser.col.organisation"]</th><th scope="col">@T["organiser.col.changed"]</th></tr></thead>
                <tbody>
                    @foreach (ListingRow row in _listings.ChangedSinceReview)
                    {
                        <tr>
                            <td><a href="/organiser/review/listings/@row.Id">@row.Title</a></td>
                            <td>@OrgName(row)</td>
                            <td>@When(row.UpdatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (_canVet)
    {
        <section aria-labelledby="orgs-heading">
            <h2 id="orgs-heading">@T["organiser.queue.organisations"] <span class="count">(@_organisations.Count)</span></h2>
            @if (_organisations.Count == 0)
            {
                <p>@T["organiser.queue.nothing"]</p>
            }
            else
            {
                <table class="queue">
                    <thead><tr><th scope="col">@T["organiser.col.organisation"]</th><th scope="col">@T["organiser.col.status"]</th><th scope="col">@T["organiser.col.applied"]</th></tr></thead>
                    <tbody>
                        @foreach (OrganisationQueueRow o in _organisations)
                        {
                            <tr>
                                <td><a href="/organiser/review/organisations/@o.Id.Value">@o.DisplayName</a></td>
                                <td>@T[BrightTime.Modules.Directory.Vetting.OrganisationVetting.StatusPhrase(o.Status)]</td>
                                <td>@When(o.SubmittedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "done")] public string? Done { get; set; }

    private ListingsForReview _listings = new([], []);
    private IReadOnlyList<OrganisationQueueRow> _organisations = [];
    private readonly Dictionary<Guid, string> _orgNames = [];
    private bool _canVet;

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            return;
        }

        _listings = await Get<ListingEditor>().ReviewQueueAsync();

        var directory = Get<IDirectoryQueries>();
        foreach (var org in _listings.AwaitingReview.Concat(_listings.ChangedSinceReview).Select(r => r.OrganisationId).Distinct())
        {
            _orgNames[org.Value] = await directory.GetOrganisationNameAsync(org) ?? T["organiser.unknown"];
        }

        _canVet = User.HasPermission(Permissions.Organisations.Vet);
        if (_canVet)
        {
            _organisations = await Get<OrganisationReview>().QueueAsync();
        }
    }

    private string OrgName(ListingRow row) => _orgNames.GetValueOrDefault(row.OrganisationId.Value, T["organiser.unknown"]);

    private string When(DateTimeOffset? at) => at is { } t ? T.DayTime(t) : "";
}
