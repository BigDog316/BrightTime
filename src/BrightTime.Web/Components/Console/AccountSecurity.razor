@page "/account/security"
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Infrastructure.Auditing
@using BrightTime.Modules.Identity.SignIn
@using BrightTime.Web.Auditing
@using BrightTime.SharedKernel.Ids
@using Microsoft.AspNetCore.Authorization
@* Changing how the account signs in is a step-up action (T21): the page itself needs a recent confirmation. *@
@attribute [Authorize(Policy = BrightTime.Web.Auth.StepUp.Policy)]
@inherits ConsoleComponent

<PageTitle>Sign-in and security · BrightTime</PageTitle>

<h1>Sign-in and security</h1>

@if (!Availability.CanSignIn)
{
    <p>Accounts are not available on this site.</p>
}
else
{
    @if (Added == "1")
    {
        <p class="notice success" role="status">Passkey added. Next time, choose "Sign in with a passkey".</p>
    }
    @if (_message is not null)
    {
        <p class="notice" role="status">@_message</p>
    }

    <section aria-labelledby="passkeys-heading">
        <h2 id="passkeys-heading">Passkeys</h2>
        <p>
            A passkey signs you in with your fingerprint, face or device PIN instead of a password. It can't be
            phished or reused on another site.
        </p>

        @if (_passkeys.Count == 0)
        {
            <p>You have no passkeys yet.</p>
        }
        else
        {
            <ul class="passkey-list">
                @foreach (PasskeySummary p in _passkeys)
                {
                    <li>
                        <span>
                            <strong>@p.Name</strong>
                            <span class="note">
                                Added @Local(p.CreatedAt)@(p.LastUsedAt is { } used ? $" · last used {Local(used)}" : " · not used yet")@(p.IsBackedUp ? " · synced" : "")
                            </span>
                        </span>
                        <form method="post" @formname="@($"revoke-{p.Id:N}")" @onsubmit="() => RevokeAsync(p.Id)">
                            <AntiforgeryToken />
                            <button type="submit" class="secondary-button">Remove<span class="visually-hidden"> @p.Name</span></button>
                        </form>
                    </li>
                }
            </ul>
        }

        <div class="needs-webauthn">
            <div class="editor sign-in">
                <div class="field">
                    <label for="passkey-name">Name for the new passkey</label>
                    <p class="hint" id="passkey-name-hint">So you can tell them apart, like "Work laptop".</p>
                    <input id="passkey-name" type="text" maxlength="@Passkeys.MaxNameLength" aria-describedby="passkey-name-hint" />
                </div>
            </div>
            <p class="notice error" id="passkey-error" role="alert" tabindex="-1" hidden></p>
            @* The script reads the antiforgery token from the page. *@
            <AntiforgeryToken />
            <button type="button" data-passkey-action="register">Add a passkey</button>
        </div>
        <noscript><p class="note">Adding a passkey needs JavaScript, which is off in this browser.</p></noscript>
    </section>

    @if (Providers.Count > 0)
    {
        <section aria-labelledby="external-heading">
            <h2 id="external-heading">Connected accounts</h2>
            <p>Connect an account you already use, and sign in with it next time. Connecting never shares your BrightTime information with it.</p>
            @if (ExternalMessage is { } externalMessage)
            {
                <p class="notice" role="status">@externalMessage</p>
            }
            <ul class="passkey-list">
                @foreach (var (key, provider) in Providers)
                {
                    ExternalLoginSummary? connected = _external.FirstOrDefault(e => e.DisplayName == provider.DisplayName);
                    <li>
                        <span>
                            <strong>@provider.DisplayName</strong>
                            <span class="note">@(connected is null ? "Not connected" : $"Connected {Local(connected.LinkedAt)}")</span>
                        </span>
                        @if (connected is null)
                        {
                            <form method="post" action="@BrightTime.Web.Auth.ExternalSignIn.LinkPath">
                                <AntiforgeryToken />
                                <input type="hidden" name="provider" value="@key" />
                                <button type="submit" class="secondary-button">Connect<span class="visually-hidden"> @provider.DisplayName</span></button>
                            </form>
                        }
                        else
                        {
                            <form method="post" @formname="@($"disconnect-{key}")" @onsubmit="() => DisconnectAsync(connected.Issuer)">
                                <AntiforgeryToken />
                                <button type="submit" class="secondary-button">Disconnect<span class="visually-hidden"> @provider.DisplayName</span></button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    <section aria-labelledby="password-heading">
        <h2 id="password-heading">Password</h2>
        <p>To set or change your password, <a href="/account/forgot">we'll email you a link</a>.</p>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "added")] public string? Added { get; set; }

    [SupplyParameterFromQuery(Name = "external")] public string? External { get; set; }

    [Inject] private Microsoft.Extensions.Options.IOptions<BrightTime.Web.Auth.AuthOptions> AuthSettings { get; set; } = default!;

    private IReadOnlyDictionary<string, BrightTime.Web.Auth.ExternalProviderOptions> Providers => AuthSettings.Value.External;

    private IReadOnlyList<ExternalLoginSummary> _external = [];

    private string? ExternalMessage => External switch
    {
        "connected" => "Connected. You can now sign in with it.",
        "already" => "Your account is already connected to that provider. Disconnect it first to connect a different account.",
        "in_use" => "That account is already connected to a different BrightTime account.",
        "wrong_session" => "The connection was started by a different sign-in, so nothing was connected. Try again.",
        _ => null,
    };

    private async Task DisconnectAsync(string issuer)
    {
        bool removed = await Get<ExternalLogins>().UnlinkAsync(Tenant.TenantId, Actor, issuer);
        if (removed)
        {
            Get<AuditTrail>().Record(AuthAudit.Allowed(AuthAudit.ExternalDisconnected, Actor, detail: new Dictionary<string, string> { ["issuer"] = issuer }));
        }

        _message = removed ? "Disconnected. It can no longer sign in to this account." : "That account was already disconnected.";
        _external = await Get<ExternalLogins>().ListAsync(Tenant.TenantId, Actor);
    }

    private IReadOnlyList<PasskeySummary> _passkeys = [];
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        if (Availability.CanSignIn)
        {
            _passkeys = await Get<Passkeys>().ListAsync(Tenant.TenantId, Actor);
            _external = await Get<ExternalLogins>().ListAsync(Tenant.TenantId, Actor);
        }
    }

    private async Task RevokeAsync(Guid id)
    {
        bool removed = await Get<Passkeys>().RevokeAsync(Tenant.TenantId, Actor, id);
        if (removed)
        {
            Get<AuditTrail>().Record(AuthAudit.Allowed(AuthAudit.PasskeyRemoved, Actor, detail: new Dictionary<string, string> { ["passkey"] = id.ToString("N") }));
        }

        _message = removed ? "Passkey removed. It can no longer sign in to this account." : "That passkey was already removed.";
        _passkeys = await Get<Passkeys>().ListAsync(Tenant.TenantId, Actor);
    }

    private string Local(DateTimeOffset at) =>
        TimeZoneInfo.ConvertTime(at, Tenant.TimeZone).ToString("MMM d, yyyy", Tenant.Locale.ToCulture());
}
