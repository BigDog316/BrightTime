@page "/organiser/moderation"
@using BrightTime.Modules.Community.Moderation
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.SharedKernel.Primitives
@using BrightTime.SharedKernel.Privacy
@using BrightTime.Web.Auth
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = ConsoleServices.ModerationPolicy)]
@attribute [YouthRecord(HeldMessages.Read)]
@inherits ConsoleComponent

@*
    The county's moderation queue (D114): the messages screening held, oldest first, each with why
    and the few messages before it. A moderator releases one or removes it, with a reason; nobody
    of the sender's organisation decides it.
*@
<PageTitle>@T["site.nav.moderation"] · BrightTime</PageTitle>

<h1>@T["site.nav.moderation"]</h1>
<p class="hint">@T["moderation.held.intro"]</p>

@if (Done is { Length: > 0 } && T.Has("moderation.done." + Done))
{
    <p class="notice success" role="status">@T["moderation.done." + Done]</p>
}

@if (_problem is not null)
{
    <p class="notice error" role="alert">@_problem</p>
}

@if (!Availability.IsAvailable)
{
    <p>@T["moderation.no_database"]</p>
}
else if (_held.Count == 0)
{
    <p>@T["moderation.held.none"]</p>
}
else
{
    <ol class="held-messages">
        @foreach (HeldMessage m in _held)
        {
            string id = m.Id.ToString("N");
            bool invalid = _reasonErrors.ContainsKey(m.Id);
            <li>
                <article aria-labelledby="held-@id">
                    <h2 id="held-@id">@T.Format("moderation.held.heading", ("org", Text.Name(m.OrgName)), ("date", T.DateTime(m.SentAt)))</h2>
                    <dl class="facts">
                        <dt>@T["moderation.held.conversation"]</dt>
                        <dd dir="auto">@(m.Subject ?? T["provider.messages.no_subject"])</dd>
                        <dt>@T["moderation.held.sender"]</dt>
                        <dd>@Role(m.SenderRole)</dd>
                        <dt>@T["moderation.held.why"]</dt>
                        <dd>@string.Join(", ", m.Reasons.Select(Reason))</dd>
                    </dl>

                    @if (m.Earlier.Count > 0)
                    {
                        <h3>@T["moderation.held.earlier"]</h3>
                        <ol class="messages">
                            @foreach (EarlierMessage e in m.Earlier)
                            {
                                <li>
                                    <p class="note">@Role(e.SenderRole) · @T.DateTime(e.SentAt)</p>
                                    <p class="body" dir="auto">@e.Body</p>
                                </li>
                            }
                        </ol>
                    }

                    <h3>@T["moderation.held.message"]</h3>
                    <blockquote class="held-body" dir="auto">@m.Body</blockquote>

                    @if (m.OwnOrganisation)
                    {
                        <p class="notice">@T["moderation.held.own_org"]</p>
                    }
                    else
                    {
                        <form method="post" class="reason-form" @formname="@("decide-" + id)" @onsubmit="() => DecideAsync(m.Id)">
                            <AntiforgeryToken />
                            <div class="field">
                                <label for="reason-@id">@T["moderation.held.reason"]</label>
                                <textarea id="reason-@id" name="reason" rows="2" maxlength="@HeldMessages.MaxReason" dir="auto"
                                          aria-invalid="@(invalid ? "true" : null)" aria-describedby="@(invalid ? "reason-" + id + "-error" : null)"></textarea>
                                @if (invalid)
                                {
                                    <p class="field-error" id="reason-@id-error">@_reasonErrors[m.Id]</p>
                                }
                            </div>
                            <button type="submit" name="decision" value="release">@T["moderation.held.release"]</button>
                            @if (CanRemove)
                            {
                                <button type="submit" name="decision" value="remove" class="secondary-button">@T["moderation.held.remove"]</button>
                            }
                        </form>
                    }
                </article>
            </li>
        }
    </ol>
}

@code {
    [SupplyParameterFromQuery(Name = "done")] public string? Done { get; set; }

    private IReadOnlyList<HeldMessage> _held = [];
    private string? _problem;
    private readonly Dictionary<Guid, string> _reasonErrors = [];

    private bool CanRemove => User.HasPermission(Permissions.Moderation.Remove);

    protected override async Task OnInitializedAsync()
    {
        if (Availability.IsAvailable)
        {
            _held = await Get<HeldMessages>().ListAsync(Actor);
        }
    }

    private async Task DecideAsync(Guid message)
    {
        string decision = FormValue("decision");
        if (decision == "remove" && !CanRemove)
        {
            Forbid();
            return;
        }

        HeldMessages held = Get<HeldMessages>();
        Result result = decision == "remove"
            ? await held.RemoveAsync(Actor, message, FormValue("reason"))
            : await held.ReleaseAsync(Actor, message, FormValue("reason"));
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/organiser/moderation?done={(decision == "remove" ? "removed" : "released")}");
            return;
        }

        if (result.Error!.Code == "moderation.reason")
        {
            _reasonErrors[message] = T.Error(result.Error);
        }
        else
        {
            _problem = T.Error(result.Error);
        }
    }

    private string Role(string role) => T.Has("provider.messages.role." + role) ? T["provider.messages.role." + role] : role;

    private string Reason(string reason) => T.Has("moderation.reason." + reason) ? T["moderation.reason." + reason] : reason;
}
