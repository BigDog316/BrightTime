@page "/organiser/moderation/history"
@using BrightTime.Modules.Community.Moderation
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.SharedKernel.Primitives
@using BrightTime.SharedKernel.Privacy
@using BrightTime.Web.Auth
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = ConsoleServices.ModerationPolicy)]
@attribute [YouthRecord(ModerationHistory.Read)]
@inherits ConsoleComponent

@*
    The moderation trail, read back (D116). With ?message=, or ?post= for a post in a space (D121),
    one item's whole story: as it is now, then what screening, reporters and moderators did, in
    order, each decision with who made it and their note. Without, the county's recent decisions,
    each linking to its story. Never of the moderator's own organisation's conversations or spaces.
*@
<PageTitle>@T["moderation.history.title"] · BrightTime</PageTitle>

<p class="eyebrow"><a href="/organiser/moderation">@T["site.nav.moderation"]</a></p>
<h1>@T["moderation.history.title"]</h1>

@if (Done is { Length: > 0 } && T.Has("moderation.done." + Done))
{
    <p class="notice success" role="status">@T["moderation.done." + Done]</p>
}

@if (_problem is not null)
{
    <p class="notice error" role="alert">@_problem</p>
}
else if (!Availability.IsAvailable)
{
    <p>@T["moderation.no_database"]</p>
}
else if (_history is { } h)
{
    <section aria-labelledby="message-heading">
        <h2 id="message-heading">@T[IsAPost ? "moderation.history.post" : "moderation.history.message"]</h2>
        <dl class="facts">
            <dt>@T["moderation.reports.organisation"]</dt>
            <dd><bdi>@h.OrgName</bdi></dd>
            @if (IsAPost)
            {
                <dt>@T["moderation.posts.space"]</dt>
                <dd dir="auto">@h.Where</dd>
                <dt>@T["moderation.posts.author"]</dt>
                <dd>@Role(h.AuthorRole)</dd>
            }
            else
            {
                <dt>@T["moderation.held.conversation"]</dt>
                <dd dir="auto">@(h.Where ?? T["provider.messages.no_subject"])</dd>
                <dt>@T["moderation.held.sender"]</dt>
                <dd>@Role(h.AuthorRole)</dd>
            }
            <dt>@T["moderation.history.state"]</dt>
            <dd>@(T.Has("moderation.history.state." + h.State) ? T["moderation.history.state." + h.State] : h.State)</dd>
        </dl>
        <blockquote class="held-body" dir="auto">@h.Body</blockquote>
    </section>

    @* D119: what's been done to the sender, and muting or suspending them, an adult, for a time. *@
    @if (!IsAPost && h.AuthorIsAdult && _restrictions is { } restrictions)
    {
        <section aria-labelledby="sender-heading">
            <h2 id="sender-heading">@T["moderation.restrict.heading"]</h2>
            @if (_actionProblem is not null)
            {
                <p class="notice error" role="alert">@_actionProblem</p>
            }
            @if (restrictions.Count == 0)
            {
                <p>@T["moderation.restrict.none"]</p>
            }
            else
            {
                <ul class="history">
                    @foreach (RestrictionView r in restrictions)
                    {
                        string rid = r.Id.ToString("N");
                        <li>
                            <p>@T.Format("moderation.restrict.item." + r.Kind, ("moderator", r.ImposedBy), ("until", T.DateTime(r.EndsAt)))</p>
                            <p><span class="note">@T["moderation.history.note"]:</span> <q dir="auto">@r.Reason</q></p>
                            @if (r.LiftedAt is { } lifted)
                            {
                                <p class="note">@T.Format("moderation.restrict.lifted", ("moderator", r.LiftedBy ?? ""), ("date", T.DateTime(lifted)))</p>
                            }
                            else if (r.InForce && CanRestrict)
                            {
                                <form method="post" class="reason-form" @formname="@("lift-" + rid)" @onsubmit="() => LiftAsync(r.Id)">
                                    <AntiforgeryToken />
                                    <div class="field">
                                        <label for="lift-@rid">@T["moderation.restrict.lift_reason"]</label>
                                        <textarea id="lift-@rid" name="reason" rows="2" maxlength="@Restrictions.MaxReason" dir="auto"></textarea>
                                    </div>
                                    <button type="submit" class="secondary-button">@T["moderation.restrict.lift"]</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }

            @if (CanRestrict)
            {
                <form method="post" class="reason-form" @formname="restrict" @onsubmit="RestrictAsync">
                    <AntiforgeryToken />
                    <fieldset>
                        <legend>@T["moderation.restrict.what"]</legend>
                        <label class="check"><input type="radio" name="kind" value="@Restrictions.Mute" checked /> @T["moderation.restrict.kind.mute"]</label>
                        <label class="check"><input type="radio" name="kind" value="@Restrictions.Suspend" /> @T["moderation.restrict.kind.suspend"]</label>
                    </fieldset>
                    <div class="field">
                        <label for="restrict-length">@T["moderation.restrict.length"]</label>
                        <select id="restrict-length" name="length">
                            @foreach (string length in Restrictions.Lengths.Keys)
                            {
                                <option value="@length">@T["moderation.restrict.length." + length]</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="restrict-reason">@T["moderation.restrict.reason"]</label>
                        <textarea id="restrict-reason" name="reason" rows="2" maxlength="@Restrictions.MaxReason" dir="auto"></textarea>
                    </div>
                    <button type="submit">@T["moderation.restrict.submit"]</button>
                </form>
            }
        </section>
    }

    <section aria-labelledby="events-heading">
        <h2 id="events-heading">@T["moderation.history.events"]</h2>
        <ol class="history">
            @foreach (HistoryEvent e in h.Events)
            {
                <li>
                    <p class="note">@(e.At is { } at ? T.DateTime(at) : T["moderation.history.no_time"])</p>
                    <p>@Describe(e)</p>
                    @if (e.Note is { Length: > 0 } note)
                    {
                        <p><span class="note">@(e.Kind == HistoryKinds.Reported ? T["moderation.reports.details"] : T["moderation.history.note"]):</span> <q dir="auto">@note</q></p>
                    }
                </li>
            }
        </ol>
    </section>
}
else
{
    <section aria-labelledby="recent-heading">
        <h2 id="recent-heading">@T["moderation.history.recent"]</h2>
        @if (_recent.Count == 0)
        {
            <p>@T["moderation.history.recent_none"]</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">@T["moderation.history.col.when"]</th>
                            <th scope="col">@T["moderation.history.col.decision"]</th>
                            <th scope="col">@T["moderation.history.col.moderator"]</th>
                            <th scope="col">@T["moderation.reports.organisation"]</th>
                            <th scope="col">@T["moderation.history.note"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (RecentDecision d in _recent)
                        {
                            <tr>
                                <td><a href="@($"/organiser/moderation/history?{(d.TargetKind == "post" ? "post" : "message")}={d.TargetId:D}")">@T.DateTime(d.At)</a></td>
                                <td>@Action(d.Action)</td>
                                <td>@d.Moderator</td>
                                <td><bdi>@d.OrgName</bdi></td>
                                <td dir="auto">@d.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "message")] public Guid? MessageId { get; set; }

    [SupplyParameterFromQuery(Name = "post")] public Guid? PostId { get; set; }

    [SupplyParameterFromQuery(Name = "done")] public string? Done { get; set; }

    private IReadOnlyList<RestrictionView>? _restrictions;
    private string? _actionProblem;

    private bool CanRestrict => User.HasPermission(Permissions.Moderation.SuspendUser);

    private ItemHistory? _history;

    private bool IsAPost => _history?.Kind == "post";
    private IReadOnlyList<RecentDecision> _recent = [];
    private string? _problem;

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            return;
        }

        ModerationHistory history = Get<ModerationHistory>();
        Result<ItemHistory> found;
        if (PostId is { } post)
        {
            found = await history.ForPostAsync(Actor, post);
        }
        else if (MessageId is { } message)
        {
            found = await history.ForMessageAsync(Actor, message);
        }
        else
        {
            _recent = await history.RecentAsync(Actor);
            return;
        }

        if (found.IsSuccess)
        {
            _history = found.Value;
            _restrictions = found.Value.Kind == "message" && found.Value.AuthorIsAdult ? await Get<Restrictions>().OfSenderAsync(Actor, found.Value.Id) : null;
            return;
        }

        if (found.Error.Kind == ErrorKind.NotFound)
        {
            Navigation.NotFound();
            return;
        }

        HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        _problem = T.Error(found.Error);
    }

    private async Task RestrictAsync()
    {
        if (!CanRestrict || MessageId is not { } id)
        {
            Forbid();
            return;
        }

        Result result = await Get<Restrictions>().ImposeAsync(Actor, id, FormValue("kind"), FormValue("length"), FormValue("reason"));
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/organiser/moderation/history?message={id:D}&done=restricted");
            return;
        }

        _actionProblem = T.Error(result.Error!);
    }

    private async Task LiftAsync(Guid restriction)
    {
        if (!CanRestrict || MessageId is not { } id)
        {
            Forbid();
            return;
        }

        Result result = await Get<Restrictions>().LiftAsync(Actor, restriction, FormValue("reason"));
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/organiser/moderation/history?message={id:D}&done=restriction_lifted");
            return;
        }

        _actionProblem = T.Error(result.Error!);
    }

    private string Describe(HistoryEvent e)
    {
        string who = e.Actor ?? "";
        return e.Kind switch
        {
            HistoryKinds.Restricted => T.Format("moderation.history.event.restricted." + e.Codes[0], ("moderator", who), ("until", e.Until is { } until ? T.DateTime(until) : "")),
            HistoryKinds.RestrictionLifted => T.Format("moderation.history.event.restriction_lifted." + e.Codes[0], ("moderator", who)),
            HistoryKinds.Held => T.Format("moderation.history.event.screened_held", ("reasons", string.Join(", ", e.Codes.Select(Reason)))),
            HistoryKinds.Passed => T["moderation.history.event.screened_passed"],
            HistoryKinds.Reported => T.Format("moderation.history.event.reported", ("role", Role(who)),
                ("reason", T["moderation.report_reason." + e.Codes[0]]), ("severity", T["moderation.severity." + e.Codes[1]])),
            HistoryKinds.TakenOn => T.Format("moderation.history.event.taken_on", ("moderator", who)),
            HistoryKinds.EscalationClosed => T.Format("moderation.history.event.escalation_closed", ("moderator", who)),
            _ => T.Has("moderation.history.event.decided." + e.Codes[0])
                ? T.Format("moderation.history.event.decided." + e.Codes[0], ("moderator", who))
                : e.Codes[0],
        };
    }

    private string Action(string action) => T.Has("moderation.history.action." + action) ? T["moderation.history.action." + action] : action;

    /// <summary>A participant's role in a conversation, or a member's in a space (D121: youth or staff, the same words).</summary>
    private string Role(string role) => T.Has("provider.messages.role." + role) ? T["provider.messages.role." + role] : role;

    private string Reason(string reason) => T.Has("moderation.reason." + reason) ? T["moderation.reason." + reason] : reason;
}
