@* A question's fields in the form builder (D62): the words, the kind, and the kind's limits. *@
@using System.Globalization
@using BrightTime.Modules.Enrollment.Forms
@using BrightTime.SharedKernel.Primitives
<div class="field">
    <label for="@($"{Prefix}-label")">@T["provider.forms.q.label"]</label>
    <input id="@($"{Prefix}-label")" name="label" maxlength="300" required value="@(Text(Question?.Label, Locale.Default.Code))" dir="auto" />
</div>
<div class="field">
    <label for="@($"{Prefix}-help")">@T["provider.forms.q.help"]</label>
    <input id="@($"{Prefix}-help")" name="help" maxlength="1000" value="@(Text(Question?.Help, Locale.Default.Code))" dir="auto" />
</div>
<div class="field">
    <label for="@($"{Prefix}-kind")">@T["provider.forms.q.kind"]</label>
    <select id="@($"{Prefix}-kind")" name="kind">
        @foreach (string kind in Kinds)
        {
            <option value="@kind" selected="@(kind == (Question?.Kind ?? FormSchema.Kinds.ShortText))">@T["provider.forms.kind." + kind]</option>
        }
    </select>
</div>
<div class="field">
    <label for="@($"{Prefix}-choices")">@T["provider.forms.q.choices"]</label>
    <textarea id="@($"{Prefix}-choices")" name="choices" rows="4" aria-describedby="@($"{Prefix}-choices-hint")" dir="auto">@Choices</textarea>
    <p class="hint" id="@($"{Prefix}-choices-hint")">@T["provider.forms.q.choices_hint"]</p>
</div>
<div class="field-row">
    <div class="field">
        <label for="@($"{Prefix}-max-length")">@T["provider.forms.q.max_length"]</label>
        <input id="@($"{Prefix}-max-length")" name="maxLength" type="number" min="1" max="5000" value="@(Question?.MaxLength?.ToString(CultureInfo.InvariantCulture))" />
    </div>
    <div class="field">
        <label for="@($"{Prefix}-min")">@T["provider.forms.q.min"]</label>
        <input id="@($"{Prefix}-min")" name="min" inputmode="decimal" value="@(Question?.Min?.ToString(CultureInfo.InvariantCulture))" />
    </div>
    <div class="field">
        <label for="@($"{Prefix}-max")">@T["provider.forms.q.max"]</label>
        <input id="@($"{Prefix}-max")" name="max" inputmode="decimal" value="@(Question?.Max?.ToString(CultureInfo.InvariantCulture))" />
    </div>
</div>
<div class="field checkbox">
    <input id="@($"{Prefix}-required")" name="required" type="checkbox" value="true" checked="@(Question?.Required ?? false)" />
    <label for="@($"{Prefix}-required")">@T["provider.forms.q.required"]</label>
</div>
<div class="field checkbox">
    <input id="@($"{Prefix}-sensitive")" name="sensitive" type="checkbox" value="true" checked="@(Question?.Sensitive ?? false)" aria-describedby="@($"{Prefix}-sensitive-hint")" />
    <label for="@($"{Prefix}-sensitive")">@T["provider.forms.q.sensitive"]</label>
    <p class="hint" id="@($"{Prefix}-sensitive-hint")">@T["provider.forms.q.sensitive_hint"]</p>
</div>
<details>
    <summary>@T["provider.forms.q.translations"]</summary>
    @foreach (Locale locale in QuestionInput.Others)
    {
        <div class="field">
            <label for="@($"{Prefix}-label-{locale.Code}")">@locale.NativeName</label>
            <input id="@($"{Prefix}-label-{locale.Code}")" name="@($"label-{locale.Code}")" maxlength="300" lang="@locale.Code" dir="@(locale.IsRightToLeft ? "rtl" : "ltr")"
                   value="@(Text(Question?.Label, locale.Code))" />
        </div>
    }
</details>

@code {
    private static readonly string[] Kinds =
        [FormSchema.Kinds.ShortText, FormSchema.Kinds.LongText, FormSchema.Kinds.Number, FormSchema.Kinds.Date, FormSchema.Kinds.YesNo,
         FormSchema.Kinds.SingleChoice, FormSchema.Kinds.MultiChoice, FormSchema.Kinds.Consent];

    /// <summary>Keeps each field's id unique when a page shows several questions.</summary>
    [Parameter, EditorRequired] public string Prefix { get; set; } = "";

    /// <summary>The question being edited; null for a new one.</summary>
    [Parameter] public FormQuestion? Question { get; set; }

    private string Choices => string.Join("\n", Question?.Choices?.Select(c => Text(c.Label, Locale.Default.Code)) ?? []);

    private static string Text(IReadOnlyDictionary<string, string>? words, string locale) =>
        words is not null && words.TryGetValue(locale, out string? text) ? text : "";
}
