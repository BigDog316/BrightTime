@page "/search"
@using BrightTime.Infrastructure.Tenancy
@using BrightTime.Modules.Directory.Contracts
@using BrightTime.Modules.Opportunities.Contracts
@using BrightTime.Modules.Opportunities.Search
@using BrightTime.Modules.Platform.Contracts
@using BrightTime.SharedKernel.Ids
@using BrightTime.SharedKernel.Primitives
@using BrightTime.SharedKernel.Text
@using Microsoft.AspNetCore.WebUtilities
@inject IListingFinder Finder
@inject ITenantContext Tenant
@inject IGeographyQueries Geography
@inject IOrganisationProfiles Organisations

<PageTitle>@T["finder.title"] · BrightTime</PageTitle>

<h1>@T["finder.title"]</h1>

@* The form is a plain GET: it works with JavaScript off, and every filter lives in the URL. *@
<form method="get" action="/search" role="search" class="finder-form" aria-labelledby="filters-heading">
    <h2 id="filters-heading" class="visually-hidden">@T["finder.filters"]</h2>

    @foreach ((string name, string? value) in Carried)
    {
        <input type="hidden" name="@name" value="@value" />
    }

    <div class="field">
        <label for="q">@T["finder.field.text"]</label>
        <input id="q" name="q" type="search" maxlength="200" value="@Q"
               aria-invalid="@InvalidMarker("q")" aria-describedby="@DescribedBy("q")" />
        @FieldError("q")
    </div>

    <fieldset class="field">
        <legend>@T["finder.field.kind"]</legend>
        @foreach (string value in KindOptions)
        {
            <label class="check">
                <input type="checkbox" name="kind" value="@value" checked="@IsKindChecked(value)" />
                @T["finder.kind_filter." + value]
            </label>
        }
    </fieldset>

    <div class="field-row">
        <div class="field">
            <label for="age">@T["finder.field.age"]</label>
            <input id="age" name="age" type="number" min="0" max="30" inputmode="numeric" value="@Age"
                   aria-invalid="@InvalidMarker("age")" aria-describedby="@DescribedBy("age")" />
            @FieldError("age")
        </div>

        <div class="field">
            <label for="maxDollars">@T["finder.field.max_price"]</label>
            <input id="maxDollars" name="maxDollars" type="number" min="0" max="100000" inputmode="numeric" value="@MaxDollars"
                   aria-invalid="@InvalidMarker("maxDollars")" aria-describedby="@DescribedBy("maxDollars")" />
            @FieldError("maxDollars")
        </div>
    </div>

    @if (_hoods.Count > 0)
    {
        <div class="field">
            <label for="hood">@T["finder.field.neighbourhood"]</label>
            <select id="hood" name="hood">
                <option value="">@T["finder.field.anywhere"]</option>
                @foreach (NeighbourhoodShape h in _hoods)
                {
                    <option value="@h.Code" selected="@(h.Code == Hood)">@h.Name</option>
                }
            </select>
        </div>
    }

    <label class="check">
        <input type="checkbox" name="free" value="1" checked="@IsFreeChecked" />
        @T["finder.field.free"]
    </label>

    <div class="field">
        <label for="sort">@T["finder.field.sort"]</label>
        <select id="sort" name="sort" aria-invalid="@InvalidMarker("sort")" aria-describedby="@DescribedBy("sort")">
            @foreach (string value in SortOptions)
            {
                <option value="@value" selected="@(Sort == value)">@T["finder.sort." + value]</option>
            }
        </select>
        @FieldError("sort")
    </div>

    <div class="actions">
        <button type="submit">@T["finder.search"]</button>
        <a href="@ClearHref" class="secondary">@T["finder.clear"]</a>
    </div>
</form>

@if (_organisation is { } org)
{
    <p class="filter-chip">
        @T.Format("finder.filter.organisation", ("organisation", Localisation.Text.Name(org.DisplayName)))
        <a href="@Href(org: null)">@T["finder.filter.remove"]</a>
    </p>
}

@if (Parse is { FieldErrors.Count: > 0 } errored)
{
    <section class="error-summary" aria-labelledby="error-summary-heading">
        <h2 id="error-summary-heading">@T["form.check_fields"]</h2>
        <ul>
            @foreach (var (field, message) in errored.FieldErrors)
            {
                <li><a href="#@field">@T[message]</a></li>
            }
        </ul>
    </section>
}

@if (_notices.Count > 0)
{
    <ul class="notices">
        @foreach (Phrase notice in _notices)
        {
            <li>@T[notice]</li>
        }
    </ul>
}

@if (Parse is { IsValid: true })
{
    @if (_hoods.Count > 0)
    {
        <nav class="view-switch" aria-label="@T["finder.view.label"]">
            <a href="@Href(view: null)" aria-current="@(IsMap ? null : "page")">@T["finder.view.list"]</a>
            <a href="@Href(view: "map")" aria-current="@(IsMap ? "page" : null)">@T["finder.view.map"]</a>
        </nav>
    }

    @if (IsMap && _hoods.Count > 0)
    {
        <section aria-labelledby="map-heading" class="results-map">
            <h2 id="map-heading">@T["finder.map.heading"]</h2>
            <p class="hint">@T["finder.map.hint"]</p>
            <NeighbourhoodMap Shapes="_hoods" Counts="_counts" Href="@(h => Href(hood: h.Code, view: null))"
                              Highlight="_hood?.Id" Label="@T["finder.map.heading"]" />
            <ul class="hood-list">
                @foreach (NeighbourhoodShape h in _hoods.OrderByDescending(h => _counts.ByNeighbourhood.GetValueOrDefault(h.Id)).ThenBy(h => h.Name))
                {
                    <li><a href="@Href(hood: h.Code, view: null)">@T.Format("map.area", ("name", h.Name), ("count", _counts.ByNeighbourhood.GetValueOrDefault(h.Id)))</a></li>
                }
                @if (_counts.OnlineOnly > 0)
                {
                    <li>@T.Format("map.online", ("count", _counts.OnlineOnly))</li>
                }
            </ul>
        </section>
    }
    else
    {
        <section aria-labelledby="results-heading" class="results">
            <h2 id="results-heading">@ResultsHeading</h2>

            @if (_page.Items.Count == 0)
            {
                <p class="empty">@T["finder.results.none"]</p>
            }
            else
            {
                <ol class="listing-list">
                    @foreach (FinderItem item in _page.Items)
                    {
                        <li class="listing">
                            <ListingCard Item="item" Lang="@Lang" ShowReasons="true" Organisation="@_links.GetValueOrDefault(item.OrganisationId)" />
                        </li>
                    }
                </ol>

                @if (_page.NextCursor is { } cursor)
                {
                    <nav class="pager" aria-label="@T["finder.results.pages"]">
                        <a rel="next" href="@Href(after: cursor)">@T["finder.results.more"]</a>
                    </nav>
                }
            }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "kind")] public string[]? Kind { get; set; }

    [SupplyParameterFromQuery(Name = "age")] public string? Age { get; set; }

    [SupplyParameterFromQuery(Name = "free")] public string? Free { get; set; }

    [SupplyParameterFromQuery(Name = "maxDollars")] public string? MaxDollars { get; set; }

    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "after")] public string? After { get; set; }

    [SupplyParameterFromQuery(Name = "lang")] public string? Lang { get; set; }

    /// <summary>A neighbourhood, by its code (<c>westside</c>).</summary>
    [SupplyParameterFromQuery(Name = "hood")] public string? Hood { get; set; }

    /// <summary>An organisation, by its page's slug.</summary>
    [SupplyParameterFromQuery(Name = "org")] public string? Org { get; set; }

    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    private FinderRequestParse? Parse { get; set; }

    private FinderPage _page = FinderPage.Empty;
    private NeighbourhoodCounts _counts = NeighbourhoodCounts.None;
    private IReadOnlyList<NeighbourhoodShape> _hoods = [];
    private NeighbourhoodShape? _hood;
    private OrganisationProfile? _organisation;
    private IReadOnlyDictionary<OrganisationId, OrganisationLink> _links = new Dictionary<OrganisationId, OrganisationLink>();
    private readonly List<Phrase> _notices = [];

    private static readonly string[] KindOptions = ["program", "event", "job", "resource"];

    private static readonly string[] SortOptions = ["relevance", "soonest", "nearest", "newest"];

    private bool IsMap => View == "map";

    /// <summary>The parameters the form carries but does not show: the language and the organisation filter.</summary>
    private IEnumerable<(string Name, string? Value)> Carried =>
        new (string, string?)[] { ("lang", Lang), ("org", _organisation is null ? null : Org), ("view", IsMap ? View : null) }
            .Where(p => p.Item2 is not null);

    protected override async Task OnParametersSetAsync()
    {
        Parse = FinderRequestParser.Parse(RawValues(includeAfter: true), Tenant.TenantId.Value, Tenant.Locale);
        _notices.AddRange(Parse.Notices);
        _hoods = await Geography.GetNeighbourhoodsAsync(Tenant.Locale.Code);

        if (!Parse.IsValid)
        {
            return;
        }

        SearchQuery query = Parse.Query!;
        if (!string.IsNullOrWhiteSpace(Hood))
        {
            _hood = _hoods.FirstOrDefault(h => string.Equals(h.Code, Hood.Trim(), StringComparison.OrdinalIgnoreCase));
            if (_hood is null)
            {
                _notices.Add(Phrase.Of("finder.notice.unknown_neighbourhood"));
            }
            else
            {
                query = query with { AllFacets = [.. query.AllFacets ?? [], ListingFacets.NeighbourhoodToken(_hood.Id)] };
            }
        }

        if (!string.IsNullOrWhiteSpace(Org))
        {
            _organisation = await Organisations.GetAsync(Org.Trim());
            if (_organisation is null)
            {
                _notices.Add(Phrase.Of("finder.notice.unknown_organisation"));
            }
            else
            {
                query = query with { OrganisationId = _organisation.Id.Value };
            }
        }

        if (IsMap)
        {
            // The map counts every neighbourhood under the other filters, so it is never narrowed to one.
            SearchQuery wide = _hood is null ? query : Parse.Query! with { OrganisationId = query.OrganisationId };
            _counts = await Finder.CountByNeighbourhoodAsync(wide);
        }
        else
        {
            _page = await Finder.SearchAsync(query);
            _links = await Organisations.GetLinksAsync([.. _page.Items.Select(i => i.OrganisationId)]);
        }
    }

    private Dictionary<string, string[]> RawValues(bool includeAfter)
    {
        Dictionary<string, string[]> values = new(StringComparer.Ordinal);

        void Add(string key, string? value)
        {
            if (!string.IsNullOrEmpty(value))
            {
                values[key] = [value];
            }
        }

        Add("q", Q);
        Add("age", Age);
        Add("free", Free);
        Add("maxDollars", MaxDollars);
        Add("sort", Sort);
        Add("lang", Lang);

        if (Kind is { Length: > 0 } kinds)
        {
            values["kind"] = kinds;
        }

        if (includeAfter)
        {
            Add("after", After);
        }

        return values;
    }

    private const string Keep = "\u0000keep";

    /// <summary>This search with some parameters changed. A cursor applies only to the page it came from.</summary>
    private string Href(string? hood = Keep, string? org = Keep, string? view = Keep, string? after = null)
    {
        List<KeyValuePair<string, string?>> query = [];
        foreach ((string key, string[] vals) in RawValues(includeAfter: false))
        {
            query.AddRange(vals.Select(v => new KeyValuePair<string, string?>(key, v)));
        }

        void Set(string key, string? value, string? current)
        {
            string? chosen = value == Keep ? current : value;
            if (!string.IsNullOrEmpty(chosen))
            {
                query.Add(new(key, chosen));
            }
        }

        Set("hood", hood, _hood?.Code);
        Set("org", org, _organisation is null ? null : Org);
        Set("view", view, IsMap ? "map" : null);
        if (after is not null)
        {
            query.Add(new("after", after));
        }

        return QueryHelpers.AddQueryString("/search", query);
    }

    private string ClearHref => Lang is null ? "/search" : $"/search?lang={Uri.EscapeDataString(Lang)}";

    private bool IsKindChecked(string value) =>
        Kind?.Any(k => string.Equals(k, value, StringComparison.OrdinalIgnoreCase)) == true;

    private bool IsFreeChecked => Free is "1" or "true" or "on";

    private bool HasError(string field) => Parse?.FieldErrors.ContainsKey(field) == true;

    /// <summary>ARIA takes lowercase "true"; an absent attribute means not invalid, so "false" is never written.</summary>
    private string? InvalidMarker(string field) => HasError(field) ? "true" : null;

    private string? DescribedBy(string field) => HasError(field) ? $"err-{field}" : null;

    private RenderFragment? FieldError(string field) => HasError(field)
        ? (RenderFragment)(builder =>
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "field-error");
            builder.AddAttribute(2, "id", $"err-{field}");
            builder.AddContent(3, T[Parse!.FieldErrors[field]]);
            builder.CloseElement();
        })
        : null;

    private string ResultsHeading
    {
        get
        {
            // "Showing" only when the results are a later page of a longer list. A stale
            // cursor restarts at page one, so the heading must describe what is shown.
            bool isLaterPage = Parse?.Query?.After is not null;
            string count = T.Format(_page.NextCursor is null && !isLaterPage ? "finder.results.count" : "finder.results.showing",
                ("count", _page.Items.Count));
            return _hood is null ? count : T.Format("finder.results.in_area", ("count", count), ("area", _hood.Name));
        }
    }
}
