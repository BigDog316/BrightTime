<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>brighttime-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BrightTime.Infrastructure/BrightTime.Infrastructure.csproj" />
    <ProjectReference Include="../BrightTime.Hosting/BrightTime.Hosting.csproj" />
    <ProjectReference Include="../BrightTime.Localisation/BrightTime.Localisation.csproj" />
    <ProjectReference Include="../BrightTime.Ui.Shared/BrightTime.Ui.Shared.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Platform/BrightTime.Modules.Platform.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Identity/BrightTime.Modules.Identity.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Directory/BrightTime.Modules.Directory.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Opportunities/BrightTime.Modules.Opportunities.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Enrollment/BrightTime.Modules.Enrollment.csproj" />
    <ProjectReference Include="../BrightTime.Modules.Attendance/BrightTime.Modules.Attendance.csproj" />
    <ProjectReference Include="../BrightTime.Reporting/BrightTime.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the API host; the web host's code used these types before they moved. -->
    <Using Include="BrightTime.Hosting.Auditing" />
    <Using Include="BrightTime.Hosting.Auth" />
    <Using Include="BrightTime.Hosting.Tenancy" />
    <Using Include="BrightTime.Hosting.Mail" />
    <!-- Text and the catalogue, shared with the API host and the app since M2. -->
    <Using Include="BrightTime.Localisation" />
  </ItemGroup>

</Project>
