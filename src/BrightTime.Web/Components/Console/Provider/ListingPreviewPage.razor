@page "/provider/orgs/{OrgId:guid}/listings/{ListingId:guid}/preview"
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Modules.Opportunities.Contracts
@using BrightTime.SharedKernel.Ids
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits ConsoleComponent

@if (Forbidden)
{
    <h1>@T["editor.preview.denied"]</h1>
}
else if (_listing is { } listing)
{
    <PageTitle>@T.Format("editor.preview.title", ("title", listing.Title)) · BrightTime</PageTitle>
    <p class="notice" role="note">
        @T["editor.preview.explain"]
        <a href="/provider/orgs/@OrgId/listings/@ListingId">@T["editor.preview.back"]</a>
    </p>
    <ListingView Listing="listing" ShowPublicLinks="false" />
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    [Parameter] public Guid ListingId { get; set; }

    private ListingDetail? _listing;

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            Navigation.NotFound();
            return;
        }

        if (!await CanActForAsync(new OrganisationId(OrgId), Permissions.Listings.Create))
        {
            Forbid();
            return;
        }

        _listing = await Get<IListingDetails>().GetForReviewAsync(Tenant.TenantId, ListingId, Tenant.Locale.Code);

        // The organisation is checked through the editor's own read, so one organisation's
        // staff cannot preview another's draft by guessing an id.
        var owned = await Get<BrightTime.Modules.Opportunities.Editing.ListingEditor>().LoadAsync(ListingId);
        if (_listing is null || owned?.OrganisationId.Value != OrgId)
        {
            _listing = null;
            Navigation.NotFound();
        }
    }
}
