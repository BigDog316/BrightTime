@page "/Error"
@using System.Diagnostics

<PageTitle>@T["site.error.title"] · BrightTime</PageTitle>

<h1>@T["site.error.title"]</h1>
<p>@T["site.error.body"]</p>

@if (ShowRequestId)
{
    @* Quoted to support staff; it identifies the request, not the person. *@
    <p>@T["site.error.reference"] <code>@RequestId</code></p>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
