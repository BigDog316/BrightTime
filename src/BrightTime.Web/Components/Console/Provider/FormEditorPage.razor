@page "/provider/orgs/{OrgId:guid}/forms/{FormId:guid}"
@using BrightTime.Modules.Enrollment.Forms
@using BrightTime.Modules.Identity.Authorization
@using BrightTime.Modules.Opportunities.Contracts
@using BrightTime.Modules.Opportunities.Editing
@using BrightTime.SharedKernel.Ids
@using BrightTime.SharedKernel.Primitives
@using BrightTime.Web.Components.Console.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits ConsoleComponent

@*
    One version of a registration form (D45, D62). A draft's questions change a form at a time;
    a published version never changes, and changing it starts the next version as a draft. A
    published version is what a listing asks families to fill in.
*@
@if (Forbidden)
{
    <PageTitle>@T["site.denied.title"] · BrightTime</PageTitle>
    <h1>@T["provider.forms.denied"]</h1>
    <p>@T["error.form.forbidden"] <a href="/provider">@T["provider.go_to_organisations"]</a></p>
}
else if (_form is { } form)
{
    bool draft = form.Status == FormDefinitions.Draft;
    <PageTitle>@form.Name · BrightTime</PageTitle>

    <p class="eyebrow"><a href="/provider/orgs/@OrgId/forms">@T["provider.nav.forms"]</a></p>
    <h1 dir="auto">@form.Name</h1>
    <p>@T.Format("provider.forms.version", ("version", form.Version)) · @T["provider.forms.status." + form.Status]</p>
    <OrgNav OrgId="@OrgId" Current="forms" Role="@(RoleIn(Org) ?? "")" />

    @if (Done is { Length: > 0 } done && T.Has("provider.forms.done." + done))
    {
        <p class="notice success" role="status">@T["provider.forms.done." + done]</p>
    }
    @if (_problem is not null)
    {
        <p class="notice error" role="alert">@_problem</p>
    }

    <section aria-labelledby="questions">
        <h2 id="questions">@T["provider.forms.questions"]</h2>
        @if (!draft)
        {
            <p class="hint">@T["provider.forms.locked"]</p>
        }
        <ol class="questions">
            @for (int i = 0; i < form.Questions.Count; i++)
            {
                FormQuestion q = form.Questions[i];
                string k = q.Key;
                <li>
                    <p>
                        <strong dir="auto">@Words(q.Label)</strong>
                        <span class="note">@T["provider.forms.kind." + q.Kind]@(q.Required ? " · " + T["provider.forms.q.required"] : "")@(q.Sensitive ? " · " + T["provider.applications.sensitive"] : "")</span>
                    </p>
                    @if (q.Choices is { } choices)
                    {
                        <ul>
                            @foreach (FormChoice c in choices)
                            {
                                <li dir="auto">@Words(c.Label)</li>
                            }
                        </ul>
                    }
                    @if (draft)
                    {
                        <details>
                            <summary>@T["provider.forms.edit_question"]</summary>
                            <form method="post" @formname="@($"edit-{k}")" @onsubmit="EditAsync">
                                <AntiforgeryToken />
                                <input type="hidden" name="question" value="@k" />
                                <QuestionFields Prefix="@($"q-{k}")" Question="@q" />
                                <button type="submit">@T["provider.forms.save_question"]</button>
                            </form>
                        </details>
                        <div class="inline-actions">
                            @if (i > 0)
                            {
                                <form method="post" @formname="@($"up-{k}")" @onsubmit="UpAsync">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="question" value="@k" />
                                    <button type="submit" class="secondary">@T["provider.forms.move_up"]</button>
                                </form>
                            }
                            @if (form.Questions.Count > 1)
                            {
                                <form method="post" @formname="@($"remove-{k}")" @onsubmit="RemoveAsync">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="question" value="@k" />
                                    <button type="submit" class="secondary">@T["provider.forms.remove_question"]</button>
                                </form>
                            }
                        </div>
                    }
                </li>
            }
        </ol>

        @if (draft && form.Questions.Count < FormSchema.MaxQuestions)
        {
            <form method="post" @formname="add" @onsubmit="AddAsync" class="form-builder">
                <AntiforgeryToken />
                <fieldset>
                    <legend>@T["provider.forms.add_question"]</legend>
                    <QuestionFields Prefix="new" />
                    <button type="submit">@T["provider.forms.add_question"]</button>
                </fieldset>
            </form>
        }
    </section>

    <section aria-labelledby="version">
        <h2 id="version">@T["provider.forms.this_version"]</h2>
        <div class="inline-actions">
            @if (draft)
            {
                <form method="post" @formname="publish" @onsubmit="PublishAsync">
                    <AntiforgeryToken />
                    <button type="submit">@T["provider.forms.publish"]</button>
                </form>
            }
            else
            {
                <form method="post" @formname="revise" @onsubmit="ReviseAsync">
                    <AntiforgeryToken />
                    <button type="submit">@T["provider.forms.revise"]</button>
                </form>
                @if (form.Status == FormDefinitions.Published)
                {
                    <form method="post" @formname="retire" @onsubmit="RetireAsync">
                        <AntiforgeryToken />
                        <button type="submit" class="secondary">@T["provider.forms.retire"]</button>
                    </form>
                }
            }
        </div>
        <p class="hint">@T["provider.forms.publish_hint"]</p>
    </section>

    <section aria-labelledby="listings">
        <h2 id="listings">@T["provider.forms.listings"]</h2>
        @if (form.Listings.Count == 0)
        {
            <p>@T["provider.forms.no_listings"]</p>
        }
        else
        {
            <ul>
                @foreach (Guid listingId in form.Listings)
                {
                    <li>
                        <span dir="auto">@(_titles.GetValueOrDefault(listingId) ?? listingId.ToString())</span>
                        <form method="post" @formname="@($"detach-{listingId:N}")" @onsubmit="DetachAsync" class="inline-actions">
                            <AntiforgeryToken />
                            <input type="hidden" name="listing" value="@listingId" />
                            <button type="submit" class="secondary">@T["provider.forms.detach"]</button>
                        </form>
                    </li>
                }
            </ul>
        }

        @if (form.Status == FormDefinitions.Published && _titles.Keys.Except(form.Listings).Any())
        {
            <form method="post" @formname="attach" @onsubmit="AttachAsync" class="inline-actions">
                <AntiforgeryToken />
                <label for="attach-listing">@T["provider.forms.attach_to"]</label>
                <select id="attach-listing" name="listing">
                    @foreach ((Guid id, string title) in _titles.Where(t => !form.Listings.Contains(t.Key)).OrderBy(t => t.Value, StringComparer.CurrentCulture))
                    {
                        <option value="@id" dir="auto">@title</option>
                    }
                </select>
                <button type="submit">@T["provider.forms.attach"]</button>
            </form>
            <p class="hint">@T["provider.forms.attach_hint"]</p>
        }
    </section>
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    [Parameter] public Guid FormId { get; set; }

    [SupplyParameterFromQuery(Name = "done")] public string? Done { get; set; }

    private FormView? _form;
    private Dictionary<Guid, string> _titles = [];
    private string? _problem;

    private OrganisationId Org => new(OrgId);

    private string Words(IReadOnlyDictionary<string, string> words) =>
        words.TryGetValue(Tenant.Locale.Code, out string? mine) ? mine : words.GetValueOrDefault(Locale.Default.Code, "");

    protected override async Task OnInitializedAsync()
    {
        if (!Availability.IsAvailable)
        {
            Navigation.NotFound();
            return;
        }

        if (!await CanActForAsync(Org, Permissions.Organisations.Edit, OrganisationRoles.Admin))
        {
            Forbid();
            return;
        }

        Result<FormView> form = await Get<FormDefinitions>().GetAsync(Org, FormId);
        if (!form.IsSuccess)
        {
            Navigation.NotFound();
            return;
        }

        _form = form.Value;
        _titles = (await Get<ListingEditor>().ListForOrganisationAsync(Org))
            .Where(l => l.Status != ListingStatus.Archived)
            .ToDictionary(l => l.Id, l => l.Title);
    }

    private string Here(string done) => $"/provider/orgs/{OrgId}/forms/{FormId}?done={done}";

    private FormQuestion? Question() => _form?.Questions.FirstOrDefault(q => q.Key == FormValue("question"));

    /// <summary>Saves the draft's questions, or says what FormSchema found wrong with them.</summary>
    private async Task SaveAsync(IReadOnlyList<FormQuestion> questions, string done)
    {
        Result<FormView> saved = await Get<FormDefinitions>().UpdateAsync(Org, FormId, new FormSchema(questions));
        if (!saved.IsSuccess)
        {
            _problem = T.Error(saved.Error);
            return;
        }

        Navigation.NavigateTo(Here(done));
    }

    private async Task AddAsync()
    {
        if (_form is null)
        {
            return;
        }

        FormQuestion added = QuestionInput.Read(FormValue, null, _form.Questions.Select(q => q.Key));
        await SaveAsync([.. _form.Questions, added], "saved");
    }

    private async Task EditAsync()
    {
        if (_form is null || Question() is not { } old)
        {
            return;
        }

        FormQuestion edited = QuestionInput.Read(FormValue, old, []);
        await SaveAsync([.. _form.Questions.Select(q => q.Key == old.Key ? edited : q)], "saved");
    }

    private async Task UpAsync()
    {
        if (_form is null || Question() is not { } q)
        {
            return;
        }

        List<FormQuestion> questions = [.. _form.Questions];
        int at = questions.IndexOf(q);
        if (at > 0)
        {
            (questions[at - 1], questions[at]) = (questions[at], questions[at - 1]);
        }

        await SaveAsync(questions, "saved");
    }

    private async Task RemoveAsync()
    {
        if (_form is null || Question() is not { } q)
        {
            return;
        }

        await SaveAsync([.. _form.Questions.Where(x => x.Key != q.Key)], "saved");
    }

    private async Task PublishAsync() => Answer(await Get<FormDefinitions>().PublishAsync(Org, FormId), "published");

    private async Task RetireAsync() => Answer(await Get<FormDefinitions>().RetireAsync(Org, FormId), "retired");

    /// <summary>The next version, as a draft: the page moves to it.</summary>
    private async Task ReviseAsync()
    {
        Result<FormView> next = await Get<FormDefinitions>().ReviseAsync(Org, FormId, Actor);
        if (!next.IsSuccess)
        {
            _problem = T.Error(next.Error);
            return;
        }

        Navigation.NavigateTo($"/provider/orgs/{OrgId}/forms/{next.Value.Id}?done=revised");
    }

    private async Task AttachAsync()
    {
        if (Guid.TryParse(FormValue("listing"), out Guid listing))
        {
            Answer(await Get<FormDefinitions>().AttachAsync(Org, listing, FormId), "attached");
        }
    }

    private async Task DetachAsync()
    {
        if (Guid.TryParse(FormValue("listing"), out Guid listing) && _form?.Listings.Contains(listing) == true)
        {
            Answer(await Get<FormDefinitions>().DetachAsync(Org, listing), "detached");
        }
    }

    private void Answer(Result<FormView> result, string done) => Answer(result.IsSuccess ? Result.Success() : Result.Failure(result.Error), done);

    private void Answer(Result result, string done)
    {
        if (!result.IsSuccess)
        {
            _problem = T.Error(result.Error!);
            return;
        }

        Navigation.NavigateTo(Here(done));
    }
}
